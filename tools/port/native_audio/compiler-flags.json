{
  "CXX": "g++",
  "CCFLAGS": "-fPIC -Wwrite-strings -march=armv8-a -fvisibility=hidden -O3",
  "CXXFLAGS": "-std=c++17 -fexceptions",
  "LINKFLAGS": "-Wl,-R,'$$ORIGIN' -march=armv8-a -static-libgcc -static-libstdc++ -fvisibility=hidden -s",
  "CPPDEFINES": "deque(['LINUX_ENABLED', 'UNIX_ENABLED', 'THREADS_ENABLED', 'NDEBUG', 'GDEXTENSION'])",
  "platform": "linux",
  "arch": "arm64",
  "target": "template_release",
  "optimize": "speed"
}
