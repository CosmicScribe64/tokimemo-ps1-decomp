{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tokimemo.checkpoint-receipt.v2",
  "title": "Port checkpoint receipt v2 (T-39019, T-39018 WP-02)",
  "description": "Written by port/godot/tests/support/checkpoint_observer.gd. The native 320x240 canvas PNG is hashed from the encoded bytes and re-read before the receipt exists; receipt_sha256 covers every other field (sorted JSON, integral numbers as integers). A set file holds {schema: tokimemo.checkpoint-receipt.v2-set, receipts: {key: receipt}, errors: []}.",
  "type": "object",
  "required": ["schema", "key", "native_canvas", "clocks", "rng", "settings", "content", "renderer", "observer", "extra", "receipt_sha256"],
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "byte": {"type": "integer", "minimum": 0, "maximum": 255}
  },
  "properties": {
    "schema": {"const": "tokimemo.checkpoint-receipt.v2"},
    "key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "native_canvas": {
      "type": "object",
      "required": ["width", "height", "source", "png", "png_sha256", "rgba8_sha256"],
      "additionalProperties": false,
      "properties": {
        "width": {"const": 320},
        "height": {"const": 240},
        "source": {"enum": ["cpu_composed_image", "subviewport_1x_readback"]},
        "png": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*\\.png$"},
        "png_sha256": {"$ref": "#/$defs/sha256"},
        "rgba8_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "clocks": {
      "type": "object",
      "required": ["frame_count", "game_mode", "mode_stage", "mode_step", "substep"],
      "properties": {
        "frame_count": {"type": "integer", "minimum": 0},
        "game_mode": {"$ref": "#/$defs/byte"},
        "mode_stage": {"$ref": "#/$defs/byte"},
        "mode_step": {"$ref": "#/$defs/byte"},
        "substep": {"$ref": "#/$defs/byte"}
      }
    },
    "rng": {
      "type": "object",
      "required": ["draw_count"],
      "properties": {"draw_count": {"type": "integer", "minimum": 0}}
    },
    "settings": {
      "type": "object",
      "required": ["source", "language", "aspect", "filter"],
      "properties": {
        "source": {"type": "string"},
        "language": {"type": "string"},
        "aspect": {"type": "string"},
        "filter": {"type": "string"}
      }
    },
    "content": {"type": "object"},
    "renderer": {
      "type": "object",
      "required": ["engine", "rendering_method", "adapter", "vendor", "api"],
      "properties": {"engine": {"type": "string", "minLength": 1}}
    },
    "observer": {
      "type": "object",
      "required": ["path", "sha256", "producer", "producer_sha256"],
      "additionalProperties": false,
      "properties": {
        "path": {"const": "res://tests/support/checkpoint_observer.gd"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "producer": {"type": "string", "pattern": "^res://"},
        "producer_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "extra": {"type": "object"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  }
}
