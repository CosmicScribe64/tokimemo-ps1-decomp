{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tokimemo.visual-review.v1",
  "title": "T-39026 human visual review queue",
  "description": "Queue items are bound to the sha256 of their contact-sheet image. Human verdicts and agent notes are separate lists; an agent may close only objective items (items with linter findings), and only as resolved-objective, never approved. The queue file and its images stay under .asset-cache.",
  "type": "object",
  "required": ["schema", "queue_id", "created_utc", "items", "deferred"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "tokimemo.visual-review.v1"},
    "queue_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_utc": {"$ref": "#/$defs/utc"},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "deferred": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "severity", "reason"],
        "additionalProperties": false,
        "properties": {
          "item_id": {"$ref": "#/$defs/item_id"},
          "severity": {"$ref": "#/$defs/severity"},
          "reason": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "item_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "severity": {"type": "integer", "minimum": 0, "maximum": 3},
    "state": {"enum": ["pending", "approved", "rejected", "needs-fix", "needs-art", "resolved-objective"]},
    "closed_by": {"enum": [null, "human", "agent"]},
    "item": {
      "type": "object",
      "required": ["item_id", "checkpoint", "kind", "severity", "image_path", "image_sha256", "state", "closed_by",
                   "defect_id", "findings", "human_verdicts", "agent_notes", "invalidated"],
      "additionalProperties": false,
      "properties": {
        "item_id": {"$ref": "#/$defs/item_id"},
        "checkpoint": {"type": "string", "minLength": 1},
        "kind": {"enum": ["objective", "subjective"]},
        "severity": {"$ref": "#/$defs/severity"},
        "image_path": {"type": "string", "minLength": 1},
        "image_sha256": {"$ref": "#/$defs/sha256"},
        "state": {"$ref": "#/$defs/state"},
        "closed_by": {"$ref": "#/$defs/closed_by"},
        "defect_id": {"type": ["string", "null"]},
        "findings": {"type": "array", "items": {"type": "string"}},
        "human_verdicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["state", "reviewer", "recorded_utc", "image_sha256", "note"],
            "additionalProperties": false,
            "properties": {
              "state": {"enum": ["approved", "rejected", "needs-fix", "needs-art"]},
              "reviewer": {"type": "string", "minLength": 1},
              "recorded_utc": {"$ref": "#/$defs/utc"},
              "image_sha256": {"$ref": "#/$defs/sha256"},
              "note": {"type": "string"}
            }
          }
        },
        "agent_notes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["agent", "recorded_utc", "image_sha256", "note", "proposed_state", "closes"],
            "additionalProperties": false,
            "properties": {
              "agent": {"type": "string", "minLength": 1},
              "recorded_utc": {"$ref": "#/$defs/utc"},
              "image_sha256": {"$ref": "#/$defs/sha256"},
              "note": {"type": "string"},
              "proposed_state": {"enum": [null, "pending", "approved", "rejected", "needs-fix", "needs-art", "resolved-objective"]},
              "closes": {"type": "boolean"}
            }
          }
        },
        "invalidated": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["image_sha256", "state", "closed_by", "recorded_utc", "reason"],
            "additionalProperties": false,
            "properties": {
              "image_sha256": {"$ref": "#/$defs/sha256"},
              "state": {"$ref": "#/$defs/state"},
              "closed_by": {"$ref": "#/$defs/closed_by"},
              "recorded_utc": {"$ref": "#/$defs/utc"},
              "reason": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
