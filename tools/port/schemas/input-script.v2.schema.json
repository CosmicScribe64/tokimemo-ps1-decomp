{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tokimemo.input-script.v2",
  "title": "Route-driver input script (v2; v1 stays accepted)",
  "description": "The v1 timing rule plus calendar and cursor predicates, pulse, save_relaunch and repeat segments, and observed checkpoints. tools/emu/route_script.py is the reference validator and rule (semantic checks beyond this schema: unique ids after repeat expansion, hold < every, checkpoint predicates naming mode/stage/step or a month). Players accept only expanded scripts (no repeat).",
  "type": "object",
  "required": ["schema", "name", "description", "provenance", "segments", "checkpoints", "unsupported"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "tokimemo.input-script.v2"},
    "name": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "description": {"type": "string", "minLength": 10},
    "provenance": {"type": "object", "required": ["source", "derivation"]},
    "start": {"type": "object", "properties": {"native": {"type": "string"}, "port": {"type": "string"}}},
    "segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/segment"}},
    "checkpoints": {"type": "array", "items": {"$ref": "#/$defs/checkpoint"}},
    "unsupported": {
      "type": "array",
      "description": "Pinned stops. A run passes only on script completion or on a stop whose text equals the stop of a row for its side AND whose segment (the one the player was on when it stopped) equals the row's at_segment.",
      "items": {
        "type": "object",
        "required": ["side", "stop", "at_segment", "reason"],
        "additionalProperties": false,
        "properties": {
          "side": {"enum": ["native", "port"]},
          "stop": {"type": "string", "pattern": "^[a-z][a-z0-9_ ]*: \\S.*$", "description": "the exact \"<gate>: <failure>\" stop text the player writes"},
          "at_segment": {"type": "string", "description": "id of the (expanded) segment the stop is expected at"},
          "reason": {"type": "string", "minLength": 10},
          "ticket": {"type": "string", "pattern": "^T-[0-9]{4,5}$"}
        }
      }
    },
    "known_gaps": {
      "type": "array",
      "description": "Missing capabilities without an exact stop text yet. Listed by preflight; never make a run pass.",
      "items": {
        "type": "object",
        "required": ["side", "gap", "reason"],
        "additionalProperties": false,
        "properties": {
          "side": {"enum": ["native", "port"]},
          "gap": {"type": "string"},
          "reason": {"type": "string", "minLength": 10},
          "ticket": {"type": "string", "pattern": "^T-[0-9]{4,5}$"}
        }
      }
    },
    "unsampled_ok": {
      "type": "array",
      "description": "Boundary states after which a missed pulse press is recorded in unsampled instead of stopping the run (loading states in which the original skips the pad read). Matched against the boundary just before the missed iteration. Input-segment presses are never tolerated.",
      "items": {
        "type": "object",
        "required": ["when", "evidence"],
        "additionalProperties": false,
        "properties": {
          "when": {"allOf": [{"$ref": "#/$defs/predicate"}, {"required": ["game_mode"]}]},
          "evidence": {"type": "string", "minLength": 10, "description": "the run and frame where the original was observed to skip the pad read"}
        }
      }
    }
  },
  "$defs": {
    "button": {"enum": ["SELECT", "START", "UP", "RIGHT", "DOWN", "LEFT", "L2", "R2", "L1", "R1", "TRIANGLE", "CIRCLE", "CROSS", "SQUARE"]},
    "predicate": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "game_mode": {"type": "string", "pattern": "^0x[0-9A-F]{2}$"},
        "mode_stage": {"type": "integer", "minimum": 0, "maximum": 255},
        "mode_step": {"type": "integer", "minimum": 0, "maximum": 255},
        "substep": {"type": "integer", "minimum": 0, "maximum": 255},
        "year": {"type": "integer", "minimum": 0, "maximum": 255, "description": "GameState +0x03E (0x5F = 1995)"},
        "month": {"type": "integer", "minimum": 1, "maximum": 13, "description": "GameState +0x03F"},
        "day": {"type": "integer", "minimum": 1, "maximum": 31, "description": "GameState +0x040"},
        "weekday": {"type": "integer", "minimum": 0, "maximum": 6, "description": "GameState +0x041"},
        "day_count": {"type": "integer", "minimum": 0, "maximum": 65535, "description": "GameState +0x042 (u16)"},
        "menu_cursor": {"type": "integer", "minimum": -1, "maximum": 15, "description": "GameState +0x1093 menu_cursor_0 (s8)"},
        "icon_count": {"type": "integer", "minimum": 0, "maximum": 15, "description": "GameState +0xF6D"}
      }
    },
    "event": {
      "type": "object",
      "required": ["at", "buttons", "hold"],
      "additionalProperties": false,
      "properties": {
        "at": {"type": "integer", "minimum": 0},
        "buttons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/button"}},
        "hold": {"type": "integer", "minimum": 1, "maximum": 600},
        "note": {"type": "string"}
      }
    },
    "pulse": {
      "type": "object",
      "required": ["buttons", "hold", "every", "max", "until"],
      "additionalProperties": false,
      "properties": {
        "buttons": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/button"}},
        "hold": {"type": "integer", "minimum": 1},
        "every": {"type": "integer", "minimum": 2},
        "offset": {"type": "integer", "minimum": 1, "default": 1},
        "max": {"type": "integer", "minimum": 1},
        "until": {"$ref": "#/$defs/predicate"},
        "skip_when": {"type": "array", "items": {"$ref": "#/$defs/predicate"}},
        "choose": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["when", "buttons"],
            "additionalProperties": false,
            "properties": {"when": {"$ref": "#/$defs/predicate"}, "buttons": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/button"}}}
          }
        }
      }
    },
    "segment": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9{}-]+$"},
        "kind": {"enum": ["input", "pulse", "save_relaunch", "repeat"], "default": "input"},
        "note": {"type": "string"},
        "wait_until": {"$ref": "#/$defs/predicate"},
        "only_if": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/predicate"}, "description": "checked at the anchor; when none holds the segment ends there and sends nothing"},
        "timeout_iterations": {"type": "integer", "minimum": 1},
        "run_for": {"type": "integer", "minimum": 1},
        "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
        "expect_next": {"$ref": "#/$defs/predicate"},
        "expect_state": {"type": "object", "description": "v1 name-entry values (see input-script.v1)"},
        "pulse": {"$ref": "#/$defs/pulse"},
        "slot": {"type": "integer", "minimum": 0, "maximum": 13},
        "first": {"type": "integer", "minimum": 1},
        "count": {"type": "integer", "minimum": 1},
        "body": {"type": "array", "items": {"$ref": "#/$defs/segment"}}
      }
    },
    "checkpoint": {
      "type": "object",
      "required": ["id", "when"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "when": {"$ref": "#/$defs/predicate"},
        "recurring": {"type": "boolean", "description": "fires on every rising edge as <id>-NNN"},
        "limit": {"type": "integer", "minimum": 1},
        "ram": {"type": "boolean", "description": "native: write <id>.ram.bin (needed for state comparison)"},
        "save_state": {"type": "boolean", "description": "native: write <id>.sstate at the next vsync"},
        "note": {"type": "string"}
      }
    }
  }
}
