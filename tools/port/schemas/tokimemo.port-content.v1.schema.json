{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tokimemo.port-content.v1",
  "title": "Tokimeki Memorial external port content pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "release_profile",
    "source",
    "created_by",
    "components",
    "route_capabilities"
  ],
  "properties": {
    "schema": {
      "const": "tokimemo.port-content.v1"
    },
    "schema_version": {
      "const": 1
    },
    "release_profile": {
      "const": "original-ja-ps-the-best"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "created_by": {
      "$ref": "#/$defs/createdBy"
    },
    "components": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "route_capabilities": {
      "$ref": "#/$defs/capabilities"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\/]+(?:/[^\\\\/]+)*$"
    },
    "source": {
      "type": "object",
      "required": [
        "format",
        "sha256",
        "size_bytes",
        "read_only"
      ],
      "properties": {
        "format": {
          "const": "mode2-2352"
        },
        "sha256": {
          "const": "28c3c501b0c67b87ca1e30515da73619497d509ff6adc28ff722aa02897dfb72"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "read_only": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "createdBy": {
      "type": "object",
      "required": [
        "reader",
        "media_schema",
        "reviewed_component_schema",
        "media_manifest_sha256",
        "visual_catalog_sha256",
        "cell_map_sha256",
        "input_reader_source_sha256",
        "importer_source_sha256",
        "validator_source_sha256"
      ],
      "properties": {
        "reader": {
          "const": "tools.assets.input.open_input"
        },
        "media_schema": {
          "const": "tokimemo.media.v1"
        },
        "reviewed_component_schema": {
          "const": "tokimemo-prologue-nbn-source-profile.v2"
        },
        "media_manifest_sha256": {
          "const": "26d865d627e3ab103514d256b1b36aad6fd5eed5108877d82b863c22a3e5efde"
        },
        "visual_catalog_sha256": {
          "const": "d155a2958e7e8694a9b5444412ef71843a0229b15503e713e911a9c1b5f8b4d6"
        },
        "cell_map_sha256": {
          "const": "5eb43589bb9722a2792c6d8c880141c36a7aa01fcc14fdfbe82be6de07282209"
        },
        "input_reader_source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "importer_source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "validator_source_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "componentSource": {
      "type": "object",
      "required": [
        "path",
        "format",
        "size_bytes",
        "sha256",
        "locator"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "format": {
          "const": "mode2-iso-file"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "locator": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "paletteVariant": {
      "type": "object",
      "required": [
        "palette_index",
        "source_sha256",
        "source_offset",
        "status"
      ],
      "properties": {
        "palette_index": {
          "type": [
            "integer",
            "null"
          ]
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_offset": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "useAlias": {
      "type": "object",
      "required": [
        "caller",
        "screen_context"
      ],
      "properties": {
        "caller": {
          "type": "string",
          "minLength": 1
        },
        "screen_context": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "previewMetadata": {
      "type": "object",
      "required": [
        "canonical_region_id",
        "cell_index",
        "source_variant",
        "palette_variant",
        "use_aliases",
        "width",
        "height",
        "grid_column",
        "grid_row",
        "source_texture_dimensions",
        "source_spans",
        "unused_source_spans_for_cell",
        "clut_bit15_status",
        "static_only",
        "animation_composition_proven"
      ],
      "properties": {
        "canonical_region_id": {
          "type": "string",
          "pattern": "^region-[0-9a-f]{64}$"
        },
        "cell_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "source_variant": {
          "type": "string",
          "minLength": 1
        },
        "palette_variant": {
          "$ref": "#/$defs/paletteVariant"
        },
        "use_aliases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/useAlias"
          }
        },
        "width": {
          "const": 128
        },
        "height": {
          "const": 120
        },
        "grid_column": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "grid_row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "source_texture_dimensions": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "const": 128
            },
            {
              "type": "integer",
              "const": 128
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "source_spans": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "unused_source_spans_for_cell": {
          "type": "array"
        },
        "clut_bit15_status": {
          "type": "string",
          "minLength": 1
        },
        "static_only": {
          "const": true
        },
        "animation_composition_proven": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "previewComponent": {
      "type": "object",
      "required": [
        "id",
        "version",
        "kind",
        "status",
        "capabilities",
        "source",
        "payload",
        "payload_size_bytes",
        "payload_sha256",
        "metadata"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/safeId"
        },
        "version": {
          "const": 1
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "source": {
          "$ref": "#/$defs/componentSource"
        },
        "kind": {
          "const": "png_preview"
        },
        "status": {
          "const": "available"
        },
        "payload": {
          "$ref": "#/$defs/relativePath"
        },
        "payload_size_bytes": {
          "type": "integer",
          "minimum": 33,
          "maximum": 8388608
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "metadata": {
          "$ref": "#/$defs/previewMetadata"
        }
      },
      "additionalProperties": false
    },
    "inventoryComponent": {
      "type": "object",
      "required": [
        "id",
        "version",
        "kind",
        "status",
        "capabilities",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/safeId"
        },
        "version": {
          "const": 1
        },
        "capabilities": {
          "type": "array",
          "maxItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "source": {
          "$ref": "#/$defs/componentSource"
        },
        "kind": {
          "const": "inventory_entry"
        },
        "status": {
          "const": "unsupported"
        }
      },
      "additionalProperties": false
    },
    "component": {
      "oneOf": [
        {
          "$ref": "#/$defs/previewComponent"
        },
        {
          "$ref": "#/$defs/inventoryComponent"
        }
      ]
    },
    "capabilities": {
      "type": "object",
      "required": [
        "available",
        "unavailable"
      ],
      "properties": {
        "available": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "unavailable": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
