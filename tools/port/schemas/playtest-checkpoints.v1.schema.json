{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tokimemo.playtest-checkpoints.v1",
  "title": "Player-journey and differential checkpoint catalog (T-39018 WP-01)",
  "type": "object",
  "required": ["schema", "policy", "defects", "reach", "checkpoints"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "tokimemo.playtest-checkpoints.v1"},
    "policy": {"type": "object"},
    "defects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "ticket", "class", "summary"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^T-[0-9]{4,5}(-[A-Z]+[0-9]+)?$"},
          "ticket": {"type": "string", "pattern": "^T-[0-9]{4,5}$"},
          "parent": {"type": "string", "pattern": "^T-[0-9]{4,5}$"},
          "class": {"enum": ["port_defect", "capture_domain", "open_difference", "finding", "synchronization"]},
          "summary": {"type": "string", "minLength": 10}
        }
      }
    },
    "reach": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["side", "kind", "provenance"],
        "properties": {
          "side": {"enum": ["native", "port"]},
          "kind": {"enum": ["seed_state", "input_script"]},
          "provenance": {"type": "string", "minLength": 10},
          "path": {"type": "string"},
          "sha256_prefix": {"type": "string", "pattern": "^[0-9a-f]{8,64}$"},
          "label": {"const": "path not verified"},
          "script": {"type": "string", "pattern": "^config/port/input-scripts/[a-z0-9_]+\\.json$"}
        },
        "allOf": [
          {"if": {"properties": {"kind": {"const": "seed_state"}}},
           "then": {"required": ["path", "sha256_prefix", "label"]}},
          {"if": {"properties": {"kind": {"const": "input_script"}}},
           "then": {"required": ["script"]}}
        ]
      }
    },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/checkpoint"}
    }
  },
  "$defs": {
    "bbox": {
      "description": "inclusive [x0, y0, x1, y1] in native 320x240 pixels",
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"type": "integer", "minimum": 0, "maximum": 4095}
    },
    "checkpoint": {
      "type": "object",
      "required": ["key", "group", "kind", "native_predicate", "port_observer_key", "reach", "modes", "english_risks", "expected"],
      "additionalProperties": false,
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "group": {"type": "string", "minLength": 1},
        "kind": {"enum": ["frame", "frame_timing", "state"]},
        "native_predicate": {
          "type": "object",
          "required": ["game_mode", "mode_stage", "mode_step", "substep", "occurrence", "source"],
          "properties": {
            "game_mode": {"type": "string", "pattern": "^0x[0-9A-F]{2}$"},
            "mode_stage": {"type": "integer", "minimum": 0, "maximum": 255},
            "mode_step": {"type": "integer", "minimum": 0, "maximum": 255},
            "substep": {"type": "integer", "minimum": 0, "maximum": 255},
            "occurrence": {"type": "string", "minLength": 1},
            "source": {"type": "string", "minLength": 1}
          }
        },
        "port_observer_key": {"type": "string", "minLength": 1},
        "reach": {
          "type": "object",
          "required": ["native", "port"],
          "additionalProperties": false,
          "properties": {"native": {"type": "string"}, "port": {"type": "string"}}
        },
        "modes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["F", "E", "M"]},
          "contains": {"const": "F"}
        },
        "english_risks": {"type": "array", "items": {"type": "string", "minLength": 3}},
        "timing_reference": {
          "type": "object",
          "required": ["fixture", "substep", "pads"],
          "properties": {
            "fixture": {"const": "port/godot/tests/fixtures/opening_frame_timing.json"},
            "substep": {"type": "string", "pattern": "^[0-9]+/[0-9]+/[0-9]+$"},
            "pads": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          }
        },
        "state_scope": {"type": "object", "required": ["compare", "excluded_timing_fields", "reason"]},
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "required": ["status"],
              "additionalProperties": false,
              "properties": {"status": {"const": "exact"}, "baseline": {"type": "string"}}
            },
            {
              "type": "object",
              "required": ["status", "defect_id", "residual_domain", "encodings", "exclusions", "residual_pixels", "bbox", "exact_rgba_pixels", "exact_bbox", "pinned_from"],
              "additionalProperties": false,
              "properties": {
                "status": {"const": "known_diff"},
                "defect_id": {"type": "string"},
                "related_defects": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                "residual_domain": {"const": "rgb555"},
                "encodings": {
                  "type": "object", "required": ["native", "port"], "additionalProperties": false,
                  "properties": {
                    "native": {"enum": ["zero_extended", "bit_replicated", "source_proven_mixed"]},
                    "port": {"enum": ["zero_extended", "bit_replicated", "source_proven_mixed"]}
                  }
                },
                "exclusions": {"type": "array", "uniqueItems": true, "items": {"enum": ["emulator_x0_column", "emulator_y0_row"]}},
                "residual_pixels": {"type": "integer", "minimum": 1},
                "bbox": {"$ref": "#/$defs/bbox"},
                "exact_rgba_pixels": {"type": "integer", "minimum": 1},
                "exact_bbox": {"$ref": "#/$defs/bbox"},
                "pinned_from": {
                  "type": "object", "required": ["evidence", "native_sha256", "port_sha256", "date"],
                  "properties": {
                    "evidence": {"type": "string"},
                    "native_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "port_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
                  }
                }
              }
            },
            {
              "type": "object",
              "required": ["status", "reason"],
              "additionalProperties": false,
              "properties": {"status": {"const": "unsynchronizable"}, "reason": {"type": "string", "minLength": 20}}
            }
          ]
        }
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "frame_timing"}}}, "then": {"required": ["timing_reference"]}},
        {"if": {"properties": {"kind": {"const": "state"}}}, "then": {"required": ["state_scope"]}}
      ]
    }
  }
}
