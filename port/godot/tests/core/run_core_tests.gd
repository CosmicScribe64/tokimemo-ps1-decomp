extends RefCounted
## T-29002: invented instruction inputs and explicit synthetic session callbacks.
## BIOS expected values were measured by capture_route.py bios-probe, not
## generated by the GDScript algorithm. These tests do not prove gameplay parity.

const Math = preload("res://core/native_math.gd")
const Rng = preload("res://core/native_rng.gd")
const Clock = preload("res://core/native_clock.gd")
const InputFrame = preload("res://core/input_frame.gd")
const State = preload("res://core/game_state.gd")
const Session = preload("res://core/game_session.gd")

var failures: Array[String] = []

func run() -> Array[String]:
	failures.clear()
	_test_widths_and_instructions()
	_test_division_boundaries()
	_test_clamp_sites()
	_test_measured_bios_streams()
	_test_clock()
	_test_mode_resets()
	_test_input_phase_and_service_order()
	_test_service_validation()
	_test_transaction_failures()
	_test_rng_transaction_failures()
	_test_hidden_rendering()
	return failures

func _check(condition: bool, message: String) -> void:
	if not condition:
		failures.append(message)

func _test_widths_and_instructions() -> void:
	_check(Math.u8(-1) == 255 and Math.s8(128) == -128, "byte signedness")
	_check(Math.u16(-1) == 65535 and Math.s16(32768) == -32768, "halfword signedness")
	_check(Math.u32(-1) == 4294967295 and Math.s32(0x80000000) == -2147483648, "word signedness")
	_check(Math.u32(Math.MIN64) == 0 and Math.s8(Math.MIN64) == 0, "narrow INT64_MIN without overflow")
	_check(Math.u32(9223372036854775807) == 4294967295, "narrow INT64_MAX exactly")
	_check(Math.add32(0x7fffffff, 1) == -2147483648, "ADDU overflow witness")
	_check(Math.sub32(0x80000000, 1) == 2147483647, "SUBU overflow witness")
	_check(Math.unsigned_less32(-1, 0) == false and Math.signed_less32(-1, 0), "explicit comparison promotion")
	_check(Math.sll32(0x80000001, 32) == -2147483647, "SLLV masks shift count")
	_check(Math.srl32(0x80000001, 33) == 1073741824, "SRLV logical right shift")
	_check(Math.sra32(0x80000001, 33) == -1073741824, "SRAV arithmetic right shift")
	var product: Math.WordPair = Math.multu32(0xffffffff, 0xffffffff)
	_check(product.lo == 1 and product.hi == 4294967294, "MULTU full product exceeds signed64")
	product = Math.mult32(0x80000000, 0xffffffff)
	_check(product.lo == 2147483648 and product.hi == 0, "MULT signed minimum times minus one")
	product = Math.mult32(-1, 2)
	_check(product.lo == 4294967294 and product.hi == 4294967295, "MULT signed high word")

func _test_division_boundaries() -> void:
	var division: Math.Division = Math.divmod32(-7, 3)
	_check(division.quotient == -2 and division.remainder == -1, "DIV truncates toward zero")
	division = Math.divmod32(-2147483648, -1)
	_check(division.quotient == -2147483648 and division.remainder == 0, "raw DIV overflow witness")
	division = Math.divmod32(-1, 0)
	_check(division.quotient == 1 and division.remainder == -1, "raw negative DIV zero witness")
	division = Math.divmod32(7, 0)
	_check(division.quotient == -1 and division.remainder == 7, "raw positive DIV zero witness")
	division = Math.divmodu32(-1, 0)
	_check(division.quotient == 4294967295 and division.remainder == 4294967295, "raw DIVU zero witness")
	division = Math.divmodu32(-1, 3)
	_check(division.quotient == 1431655765 and division.remainder == 0, "unsigned DIVU exact word")
	division = Math.divmod64(Math.MIN64, 3)
	_check(division.quotient == -3074457345618258602 and division.remainder == -2, "signed64 minimum exact division")
	division = Math.divmod64(9223372036854775807, 3)
	_check(division.quotient == 3074457345618258602 and division.remainder == 1, "signed64 maximum exact division")
	_check(not Math.divmod64(Math.MIN64, -1).error.is_empty(), "signed64 overflow explicitly rejected")
	_check(not Math.divmod64(1, 0).error.is_empty(), "signed64 zero explicitly rejected")

func _test_clamp_sites() -> void:
	_check(Math.parameter_change_word(0x03e800ab, 0) == 0x03e700ab, "parameter_change retains fractional halfword")
	_check(Math.parameter_change_word(0x03e700ab, 0) == 0x03e700ab, "parameter_change threshold is 1000")
	_check(Math.check_parameter_limit_word(0x03e700ab) == 0x03e70000, "check_para_limit clears fraction at 999")
	_check(Math.parameter_change_word(0x7fffffff, 1) == 0, "parameter_change wraps then negative-clamps")
	_check(Math.check_parameter_limit_word(0xfffffff0) == 0, "check_para_limit uses signed high halfword")

func _test_measured_bios_streams() -> void:
	var rng: Rng = Rng.new()
	_check(rng.next("synthetic") == -1, "unconfigured BIOS profile refuses a draw")
	var seeds: Array[int] = [0, 1, 0xffffffff, 0x80000000]
	var expected: Array = [
		[0, 21468, 9988, 22117, 3498, 16927, 16045, 19741],
		[16838, 5758, 10113, 17515, 31051, 5627, 23010, 7419],
		[15929, 4409, 9862, 26718, 8713, 28226, 9080, 32063],
		[0, 21468, 9988, 22117, 3498, 16927, 16045, 19741]]
	var final_states: Array[int] = [3441282840, 2633739833, 4248825847, 1293799192]
	for index: int in range(seeds.size()):
		_check(rng.configure(Rng.OPENBIOS_PROFILE, seeds[index]), "configure observed BIOS profile")
		for draw: int in range(8):
			_check(rng.next("synthetic/native-probe") == expected[index][draw], "BIOS stream seed %d draw %d" % [seeds[index], draw])
		_check(rng.state == final_states[index], "BIOS full state seed %d" % seeds[index])
		_check(rng.draw_count == 8 and rng.trace.size() == 8, "draw order stays observable")
	_check(not rng.configure("unmeasured-sony-bios", 0), "unknown BIOS profile rejected")
	_check(rng.next("synthetic") == -1, "failed configure invalidates previous profile")

func _test_clock() -> void:
	var one_second: Clock = Clock.new()
	var segmented: Clock = Clock.new()
	_check(one_second.queue_elapsed_ns(1000000000).is_empty(), "clock accepts one second")
	for index: int in range(1000):
		segmented.queue_elapsed_ns(1000000)
	_check(one_second.pending_steps == 60 and segmented.pending_steps == 60, "integer accumulator independent of render segmentation")
	_check(segmented.queue_elapsed_ns(100000000000).is_empty() and segmented.pending_steps == 6060, "long stall retains all pending steps")
	segmented.paused = true
	segmented.queue_elapsed_ns(1000000000)
	_check(segmented.pending_steps == 6060 and not segmented.consume_pending_step(), "pause preserves simulation debt")
	_check(not segmented.queue_elapsed_ns(Math.MIN64).is_empty(), "clock rejects negative signed64 elapsed")
	_check(one_second.vblanks == 0 and one_second.logic_iterations == 0, "elapsed time does not invent observed vblanks or logic")

func _test_mode_resets() -> void:
	var state: State = State.new()
	state.game_mode_timer = 11
	state.mode_stage_timer = 22
	state.mode_step_timer = 33
	state.mode_stage_scratch = 44
	state.substep = 55
	state.set_step(256)
	_check(state.mode_step == 0 and state.mode_step_timer == 0 and state.substep == 0, "mode_step_set byte narrowing/reset")
	_check(state.game_mode_timer == 11 and state.mode_stage_timer == 22 and state.mode_stage_scratch == 44, "step reset preserves outer timer and scratch")
	state.set_stage(257)
	_check(state.mode_stage == 1 and state.mode_stage_timer == 0 and state.mode_stage_scratch == 0, "mode_stage_set resets inner state")
	_check(state.game_mode_timer == 11, "stage reset preserves mode timer")
	state.timer_ticks = 2147483647
	state.system_seed = 2147483647
	state.timer_interrupt()
	_check(state.timer_ticks == -2147483648 and state.system_seed == -2147482762, "timer interrupt wraps signed words independently")

func _empty_phase(_state: State, _rng: Rng, _result: Session.FrameResult) -> void:
	pass

func _synthetic_session() -> Session:
	var session: Session = Session.new()
	session.state.game_mode = 0x34
	session.draw_logic = _empty_phase
	session.cd_logic = _empty_phase
	session.audio_logic = _empty_phase
	session.rng.configure(Rng.OPENBIOS_PROFILE, 1)
	return session

func _test_input_phase_and_service_order() -> void:
	var session: Session = _synthetic_session()
	var seen: Array[int] = []
	var mode: Callable = func(state: State, input: InputFrame, _rng: Rng, _result: Session.FrameResult) -> void:
		seen.append(input.pressed)
		state.reset_game_mode_fields(0x34)
	session.router.bind_mode(0x34, mode)
	var events: Array[Session.ServiceEvent] = [
		Session.ServiceEvent.new(0, Session.Phase.BEFORE_MODE, Session.ServiceKind.TIMER_INTERRUPT),
		Session.ServiceEvent.new(0, Session.Phase.DRAW_BEFORE_INPUT, Session.ServiceKind.VBLANK)]
	var result: Session.FrameResult = session.step(InputFrame.new(0, 0x20), events)
	_check(result.error.is_empty(), "synthetic ordered step succeeds")
	_check(seen == [0] and session.latched_input.pressed == 0x20, "mode reads old latch; new press arrives after draw")
	_check(session.state.game_mode_timer == 1 and session.state.mode_stage_timer == 0, "mode timer increments after mode reset; other timers unchanged")
	_check(session.state.timer_ticks == 1 and session.clock.vblanks == 1 and result.service_events_consumed == 2, "explicit interrupt/vblank delivery")
	session.step(InputFrame.new(1, 0x20), [])
	session.step(InputFrame.new(2, 0x20), [])
	_check(seen == [0, 0x20, 0], "held confirm edge consumed once across accumulated logic steps")
	var before: String = session.state_hash()
	result = session.step(InputFrame.new(99, 0), [])
	_check(not result.error.is_empty() and session.state_hash() == before, "invalid input rejected before state progression")
	var missing: Session = Session.new()
	before = missing.state_hash()
	result = missing.step(InputFrame.new(0), [])
	_check(not result.error.is_empty() and missing.state_hash() == before, "missing native mode fails before mutation")

func _test_hidden_rendering() -> void:
	var visible: Session = _synthetic_session()
	var hidden: Session = _synthetic_session()
	var mode: Callable = func(_state: State, _input: InputFrame, rng: Rng, _result: Session.FrameResult) -> void:
		rng.next("synthetic/rule")
	var actor: Callable = func(_state: State, rng: Rng, _result: Session.FrameResult) -> void:
		rng.next("synthetic/blink")
	visible.router.bind_mode(0x34, mode)
	hidden.router.bind_mode(0x34, mode)
	visible.draw_logic = actor
	hidden.draw_logic = actor
	for tick: int in range(5):
		visible.clock.rendered_frames += 3
		var left: Session.FrameResult = visible.step(InputFrame.new(tick), [])
		var right: Session.FrameResult = hidden.step(InputFrame.new(tick), [])
		_check(left.state_hash == right.state_hash and left.event_hash == right.event_hash and visible.rng.state == hidden.rng.state, "render count cannot alter rule/cosmetic RNG ordering")
	_check(visible.rng.draw_count == 10 and hidden.rng.draw_count == 10, "hidden rendering retains cosmetic draws")

func _test_service_validation() -> void:
	var session: Session = _synthetic_session()
	var mode: Callable = func(_state: State, _input: InputFrame, _rng: Rng, _result: Session.FrameResult) -> void:
		pass
	session.router.bind_mode(0x34, mode)
	var before: String = session.state_hash()
	var events: Array[Session.ServiceEvent] = [
		Session.ServiceEvent.new(0, Session.Phase.CD, Session.ServiceKind.COMPLETION, "synthetic-loader")]
	var result: Session.FrameResult = session.step(InputFrame.new(0), events)
	_check(not result.error.is_empty() and session.state_hash() == before, "missing service receiver fails before mutation")
	var received: Array[String] = []
	session.service_completion = func(event: Session.ServiceEvent, _state: State, _rng: Rng, _result: Session.FrameResult) -> void:
		received.append(event.service)
	events = [
		Session.ServiceEvent.new(0, Session.Phase.CD, Session.ServiceKind.COMPLETION, "first"),
		Session.ServiceEvent.new(0, Session.Phase.CD, Session.ServiceKind.COMPLETION, "second")]
	result = session.step(InputFrame.new(0), events)
	_check(result.error.is_empty() and received == ["first", "second"], "same-phase completion order follows captured schedule")
	before = session.state_hash()
	events = [
		Session.ServiceEvent.new(1, Session.Phase.CD, Session.ServiceKind.TIMER_INTERRUPT),
		Session.ServiceEvent.new(1, Session.Phase.BEFORE_MODE, Session.ServiceKind.TIMER_INTERRUPT)]
	result = session.step(InputFrame.new(1), events)
	_check(not result.error.is_empty() and session.state_hash() == before, "unordered external schedule fails before mutation")
	_test_stale_and_future_service_ticks()

func _test_stale_and_future_service_ticks() -> void:
	var session: Session = _synthetic_session()
	session.router.bind_mode(0x34, func(_state: State, _input: InputFrame, _rng: Rng, _result: Session.FrameResult) -> void:
		pass)
	var callbacks: Array[String] = []
	var readiness: Dictionary = {"ready": false}
	session.service_completion = func(event: Session.ServiceEvent, state: State, _rng: Rng, result: Session.FrameResult) -> void:
		callbacks.append(event.service)
		readiness["ready"] = true
		state.mode_stage_scratch = 1
		result.presentation.append({"kind": "synthetic_ready", "service": event.service})
	var current_tick: int = session.clock.logic_iterations
	var accepted := session.step(InputFrame.new(current_tick), [
		Session.ServiceEvent.new(current_tick, Session.Phase.CD, Session.ServiceKind.COMPLETION,
			"current-tick-control")])
	_check(accepted.committed and accepted.error.is_empty() and callbacks == ["current-tick-control"],
		"current-tick service completion remains accepted")
	_check(readiness["ready"] and session.state.mode_stage_scratch == 1 and accepted.presentation.size() == 1,
		"accepted current-tick control reaches callback and publishes its ready intent")
	# Clear only the synthetic readiness marker to test whether a stale/future
	# event can promote it. Session-owned state remains the rollback baseline.
	readiness["ready"] = false
	session.state.mode_stage_scratch = 0
	var tick: int = session.clock.logic_iterations
	var variants: Array[Dictionary] = [
		{"name": "stale", "tick": tick - 1},
		{"name": "future", "tick": tick + 1},
	]
	for variant: Dictionary in variants:
		var before: Dictionary = {"state": session.state.projection(), "rng": session.rng.checkpoint(),
			"clock": session.clock.snapshot(), "input": session.latched_input.snapshot(), "hash": session.state_hash()}
		var result: Session.FrameResult = session.step(InputFrame.new(tick), [
			Session.ServiceEvent.new(int(variant["tick"]), Session.Phase.CD,
				Session.ServiceKind.COMPLETION, "invalid-%s-tick" % variant["name"])])
		var after: Dictionary = {"state": session.state.projection(), "rng": session.rng.checkpoint(),
			"clock": session.clock.snapshot(), "input": session.latched_input.snapshot(), "hash": session.state_hash()}
		_check(not result.committed and result.error == "service tick does not match logic iteration",
			"%s service tick is rejected before commit" % variant["name"])
		_check(after == before and not readiness["ready"] and session.state.mode_stage_scratch == 0,
			"%s service tick leaves state/readiness/RNG/clock/input/hash unchanged" % variant["name"])
		_check(callbacks == ["current-tick-control"] and result.presentation.is_empty()
			and result.audio.is_empty() and result.transitions.is_empty() and result.trace.is_empty()
			and result.event_hash.is_empty() and result.service_events_consumed == 0,
			"%s service tick invokes no callback or output/readiness promotion" % variant["name"])

func _transaction_action(label: String, fail_at: String, calls: Array[String],
	state: State, rng: Rng, result: Session.FrameResult) -> void:
	# calls is observational test instrumentation, never a gameplay side effect.
	calls.append(label)
	state.system_seed += 101
	state.mode_stage_scratch = 23
	rng.next("synthetic/" + label)
	result.presentation.append({"synthetic": label})
	result.audio.append({"synthetic": label})
	result.transitions.append({"synthetic": label})
	if label == fail_at:
		result.error = "required operation failed at " + label
		result.error = ""
		result.error = "later diagnostic must not replace first error"

func _test_transaction_failures() -> void:
	var order: Array[String] = ["before-completion", "before-tail", "mode", "draw",
		"draw-completion", "draw-tail", "cd-completion", "cd-tail", "cd",
		"audio-completion", "audio-tail", "audio"]
	var failures_at: Array[String] = ["before-completion", "mode", "draw",
		"draw-completion", "cd-completion", "cd", "audio-completion", "audio"]
	for fail_at: String in failures_at:
		var session: Session = _synthetic_session()
		session.state.sound_active = true
		session.state.frame_count = 42
		session.state.game_mode_timer = 7
		session.state.mode_stage_timer = 9
		session.clock.queue_elapsed_ns(123456789)
		session.clock.rendered_frames = 17
		session.rng.next("synthetic/preexisting-draw")
		session.latched_input = InputFrame.new(-1, 0x10)
		var calls: Array[String] = []
		session.router.bind_mode(0x34, func(state: State, _input: InputFrame, rng: Rng, result: Session.FrameResult) -> void:
			_transaction_action("mode", fail_at, calls, state, rng, result))
		session.draw_logic = func(state: State, rng: Rng, result: Session.FrameResult) -> void:
			_transaction_action("draw", fail_at, calls, state, rng, result)
		session.cd_logic = func(state: State, rng: Rng, result: Session.FrameResult) -> void:
			_transaction_action("cd", fail_at, calls, state, rng, result)
		session.audio_logic = func(state: State, rng: Rng, result: Session.FrameResult) -> void:
			_transaction_action("audio", fail_at, calls, state, rng, result)
		session.service_completion = func(event: Session.ServiceEvent, state: State, rng: Rng, result: Session.FrameResult) -> void:
			_transaction_action(event.service, fail_at, calls, state, rng, result)
		var events: Array[Session.ServiceEvent] = [
			Session.ServiceEvent.new(0, Session.Phase.BEFORE_MODE, Session.ServiceKind.TIMER_INTERRUPT),
			Session.ServiceEvent.new(0, Session.Phase.BEFORE_MODE, Session.ServiceKind.VBLANK)]
		var prefixes: Array[String] = ["before", "draw", "cd", "audio"]
		for phase: int in range(4):
			events.append(Session.ServiceEvent.new(0, phase as Session.Phase, Session.ServiceKind.COMPLETION, prefixes[phase] + "-completion"))
			events.append(Session.ServiceEvent.new(0, phase as Session.Phase, Session.ServiceKind.COMPLETION, prefixes[phase] + "-tail"))
		var before_hash: String = session.state_hash()
		var before_clock: String = JSON.stringify(session.clock.snapshot())
		var before_rng: String = JSON.stringify(session.rng.checkpoint())
		var before_input: InputFrame = session.latched_input
		var result: Session.FrameResult = session.step(InputFrame.new(0, 0x20), events)
		_check(result.error == "required operation failed at " + fail_at, "first callback error retained: " + fail_at)
		_check(not result.committed and result.state_hash == before_hash and session.state_hash() == before_hash, "failed step restores owned state: " + fail_at)
		_check(JSON.stringify(session.clock.snapshot()) == before_clock, "failed step restores clock/debt/phase: " + fail_at)
		_check(JSON.stringify(session.rng.checkpoint()) == before_rng, "failed step restores full RNG state/history: " + fail_at)
		_check(session.latched_input == before_input, "failed step restores original input latch: " + fail_at)
		_check(calls == order.slice(0, order.find(fail_at) + 1), "no callback after first error: " + fail_at)
		_check(result.presentation.is_empty() and result.audio.is_empty() and result.transitions.is_empty(), "failed step discards outgoing intents: " + fail_at)
		_check(result.event_hash.is_empty() and result.service_events_consumed == 0, "failed step commits no events: " + fail_at)

func _test_rng_transaction_failures() -> void:
	var session: Session = _synthetic_session()
	var calls: Array[String] = []
	session.router.bind_mode(0x34, func(state: State, _input: InputFrame, rng: Rng, result: Session.FrameResult) -> void:
		_transaction_action("mode", "", calls, state, rng, result)
		rng.next("")
		# A subsequent successful draw/reseed must not erase the earlier refusal.
		rng.reseed(3)
		rng.next("synthetic/after-refusal")
		result.error = "later callback error must not replace RNG refusal")
	var before_hash: String = session.state_hash()
	var before_rng: String = JSON.stringify(session.rng.checkpoint())
	var result: Session.FrameResult = session.step(InputFrame.new(0, 0x20), [])
	_check(result.error == "RNG draw requires a source caller ID", "refused RNG draw propagates through session")
	_check(not result.committed and session.state_hash() == before_hash and JSON.stringify(session.rng.checkpoint()) == before_rng, "RNG refusal rolls back draw/reseed and state")
	_check(calls == ["mode"] and result.presentation.is_empty(), "RNG refusal discards mode intents and stops later phases")
	session.router.bind_mode(0x34, func(_state: State, _input: InputFrame, rng: Rng, output: Session.FrameResult) -> void:
		output.error = "first callback error"
		rng.next(""))
	result = session.step(InputFrame.new(0), [])
	_check(result.error == "first callback error" and session.state_hash() == before_hash, "later RNG refusal does not replace earlier callback error")
	session = _synthetic_session()
	session.rng = Rng.new()
	session.clock.queue_elapsed_ns(123456789)
	session.router.bind_mode(0x34, func(_state: State, _input: InputFrame, _rng: Rng, _result: Session.FrameResult) -> void:
		calls.append("must not run"))
	before_hash = session.state_hash()
	var before_clock: String = JSON.stringify(session.clock.snapshot())
	result = session.step(InputFrame.new(0), [])
	_check(not result.error.is_empty() and not result.committed and calls == ["mode"], "unconfigured RNG fails preflight before callbacks")
	_check(session.state_hash() == before_hash and JSON.stringify(session.clock.snapshot()) == before_clock, "unconfigured RNG leaves state and debt unchanged")
