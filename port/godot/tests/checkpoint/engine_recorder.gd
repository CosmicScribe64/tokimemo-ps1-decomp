extends RefCounted
## Development checkpoints only (tests/checkpoint/runtime_checkpoint.gd).
## Builds, at run time, a wrapper class with one forwarding method per
## OriginalAudioEngine method. Each call is forwarded unchanged to the real
## engine and logged with its arguments and the SHA-256 of var_to_bytes() of
## its result, so a resumed run can rebuild an identical engine by replaying
## the log into a fresh instance and proving every result matches.
## Installed through bgm_backend.gd's engine_factory seam; never by the app.

const NATIVE_CLASS := "OriginalAudioEngine"
const NO_ARG := "<tokimemo-checkpoint-no-arg>"
static var _wrapper_script: GDScript

## Digest of a call result without its host timing fields (render_us and the
## like are wall-clock measurements, not engine state).
static func digest(value: Variant) -> String:
	var hashing := HashingContext.new()
	hashing.start(HashingContext.HASH_SHA256)
	hashing.update(var_to_bytes(_without_timing(value)))
	return hashing.finish().hex_encode()

static func _without_timing(value: Variant) -> Variant:
	if value is Dictionary:
		var out := {}
		for key: Variant in value:
			if key is String and (key.ends_with("_us") or key.ends_with("_ms") or key.ends_with("_usec") or key.ends_with("_msec") or key.contains("time")): continue
			out[key] = _without_timing(value[key])
		return out
	if value is Array:
		var items: Array = []
		for item: Variant in value: items.append(_without_timing(item))
		return items
	return value

## The wrapper class, generated once from ClassDB.
static func wrapper_script() -> GDScript:
	if _wrapper_script != null: return _wrapper_script
	var lines := PackedStringArray([
		"extends RefCounted",
		"## Generated by tests/checkpoint/engine_recorder.gd (dev checkpoints only).",
		"const Recorder = preload(\"res://tests/checkpoint/engine_recorder.gd\")",
		"var native_engine: RefCounted",
		"var call_log: Array = []",
		"func _record(method: String, args: Array) -> Variant:",
		"\tvar trimmed := args.duplicate()",
		"\twhile not trimmed.is_empty() and trimmed[-1] is String and trimmed[-1] == Recorder.NO_ARG: trimmed.pop_back()",
		"\tvar result: Variant = native_engine.callv(method, trimmed)",
		"\tcall_log.append([method, trimmed.duplicate(true), Recorder.digest(result)])",
		"\treturn result",
	])
	for method: Dictionary in ClassDB.class_get_method_list(NATIVE_CLASS, true):
		var name: String = method.name
		if name.begins_with("_") or name in ["native_engine", "call_log"]: continue
		var params := PackedStringArray()
		var names := PackedStringArray()
		var required: int = method.args.size() - method.default_args.size()
		for index in method.args.size():
			params.append("a%d" % index if index < required else "a%d = Recorder.NO_ARG" % index)
			names.append("a%d" % index)
		lines.append("func %s(%s) -> Variant:" % [name, ", ".join(params)])
		lines.append("\treturn _record(\"%s\", [%s])" % [name, ", ".join(names)])
	var script := GDScript.new()
	script.source_code = "\n".join(lines) + "\n"
	if script.reload() != OK: return null
	_wrapper_script = script
	return script

## Factory for bgm_backend.engine_factory: a fresh recorded engine.
static func create() -> RefCounted:
	var script := wrapper_script()
	if script == null: return null
	var wrapper: RefCounted = script.new()
	wrapper.native_engine = ClassDB.instantiate(NATIVE_CLASS)
	return wrapper

## Shared with runtime_checkpoint.gd (its inner classes reach statics only
## through a preloaded script): a lambda has no named method on its object,
## unlike a method callable, bound or not.
static func is_lambda(callable: Callable) -> bool:
	return callable.is_custom() and (callable.get_object() == null or not callable.get_object().has_method(callable.get_method()))

static func is_wrapper(value: Variant) -> bool:
	return value is RefCounted and _wrapper_script != null and value.get_script() == _wrapper_script

## Rebuilds an engine from a call log: a fresh native engine receives every
## logged call in order and each result must match its logged digest.
static func replay(call_log: Array) -> Dictionary:
	var wrapper := create()
	if wrapper == null: return {"error": "native engine wrapper could not be generated"}
	for index in call_log.size():
		var entry: Array = call_log[index]
		var result: Variant = wrapper.native_engine.callv(entry[0], entry[1])
		if digest(result) != entry[2]:
			return {"error": "native engine replay diverged at call %d (%s)" % [index, entry[0]]}
	wrapper.call_log = call_log.duplicate(true)
	return {"error": "", "engine": wrapper}
