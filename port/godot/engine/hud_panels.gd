## Show or hide the command icons
func icon_disp_switch(arg0: int) -> void:
	arg0 = Math.s32(arg0)
	var i: int = 0
	var p: int = 0
	var g: int = 0
	g = GS
	if arg0 != 0:
		i = 0
		if engine.gs_get("icon_count") != 0:
			p = G_ACTOR_POOL
			while true:
				engine.memory.write_u8(p + 0x1543, engine.memory.u8(p + 0x1543) | 0x80)
				engine.memory.write_u8(p + 0x1103, engine.memory.u8(p + 0x1103) | 0x80)
				i = Math.u32(i + 1)
				p = p + 0x44
				if not (i < engine.memory.u8(g + GAME_STATE_ICON_COUNT)):
					break
	else:
		i = 0
		if engine.gs_get("icon_count") != 0:
			p = G_ACTOR_POOL
			while true:
				engine.memory.write_u8(p + 0x1543, engine.memory.u8(p + 0x1543) & 0x7F)
				engine.memory.write_u8(p + 0x1103, engine.memory.u8(p + 0x1103) & 0x7F)
				i = Math.u32(i + 1)
				p = p + 0x44
				if not (i < engine.memory.u8(g + GAME_STATE_ICON_COUNT)):
					break

## Enable or disable one of the 14 command icons
func icon_can_use_set(icon_index: int, enabled: int) -> void:
	icon_index = Math.s32(icon_index)
	enabled = Math.s32(enabled)
	if enabled != 0:
		engine.memory.write_u8(G_ICON_ENABLED + icon_index, 1)
	else:
		engine.memory.write_u8(G_ICON_ENABLED + icon_index, 0)

## Returns whether the indexed command icon is enabled.
func get_icon_can_use(icon_index: int) -> int:
	icon_index = Math.s32(icon_index)
	if engine.memory.u8(G_ICON_ENABLED + icon_index) == 1:
		return 1
	return 0

## Calls LoadSquare, actor_clear, hud_icon_layout_apply.
func hud_icon_bar_init() -> void:
	var g: int = 0
	var i: int = 0
	var zero_position_pair_count: int = 0
	var j: int = 0
	g = GS
	if engine.memory.u8(g + GAME_STATE_ICON_MODE) == 2:
		engine.memory.write_u8(g + GAME_STATE_ICON_COUNT, 0xF)
	i = 0
	while Math.u32(i) < engine.memory.u8(g + GAME_STATE_ICON_COUNT):
		engine.memory.write_u8(G_ICON_ENABLED + i, 1)
		i = Math.s32(i + 1)
	i = 0
	while Math.u32(i) < engine.memory.u8(g + GAME_STATE_ICON_COUNT):
		if engine.halted():
			break
		engine.call_c("actor_clear", [Math.s32(i + 0x50)])
		engine.memory.write_u8(G_ACTOR_POOL + Math.s32(i + 0x50) * ACTOR_SIZE + ACTOR_UNK_01, 3)
		engine.memory.write_u8(G_ACTOR_POOL + Math.s32(i + 0x50) * ACTOR_SIZE + ACTOR_FLAGS, 1)
		engine.memory.write_u32(G_ACTOR_POOL + Math.s32(i + 0x50) * ACTOR_SIZE + ACTOR_QUAD_FLAGS, 0x40000000)
		engine.memory.write_u8(G_ACTOR_POOL + Math.s32(i + 0x50) * ACTOR_SIZE + ACTOR_DRAW_FLAGS, 0x84)
		engine.memory.write_u32(G_ACTOR_POOL + Math.s32(i + 0x50) * ACTOR_SIZE + ACTOR_FRAME_TABLE, G_SPRITE_FRAME_TABLE)
		engine.memory.write_u32(G_ACTOR_POOL + Math.s32(i + 0x50) * ACTOR_SIZE + ACTOR_SEQUENCE_TABLE,
				G_ACTOR_DEFAULT_SEQUENCE_TABLE)
		engine.memory.write_u32(G_ACTOR_POOL + Math.s32(i + 0x50) * ACTOR_SIZE + ACTOR_TPAGE_TABLE,
				G_ACTOR_DEFAULT_TEXTURE_BLOCKS)
		engine.memory.write_u16(G_ACTOR_POOL + Math.s32(i + 0x50) * ACTOR_SIZE + ACTOR_UNK_14,
				engine.memory.read_global("D_800C9A54"))
		engine.memory.write_u8(G_ACTOR_POOL + Math.s32(i + 0x50) * ACTOR_SIZE + ACTOR_UNK_04, 8)
		engine.memory.write_u8(G_ACTOR_POOL + Math.s32(i + 0x50) * ACTOR_SIZE + ACTOR_UNK_05, 1)
		engine.memory.write_u16(G_ACTOR_POOL + Math.s32(i + 0x50) * ACTOR_SIZE + ACTOR_SEQUENCE_SLOT, i)
		engine.memory.write_u8(G_ACTOR_POOL + Math.s32(i + 0x50) * ACTOR_SIZE + ACTOR_BLINK_PERIOD, 1)
		engine.call_c("actor_clear", [Math.s32(i + 0x40)])
		engine.memory.write_u8(G_ACTOR_POOL + Math.s32(i + 0x40) * ACTOR_SIZE + ACTOR_UNK_01, 4)
		engine.memory.write_u8(G_ACTOR_POOL + Math.s32(i + 0x40) * ACTOR_SIZE + ACTOR_FLAGS, 0x40)
		engine.memory.write_u32(G_ACTOR_POOL + Math.s32(i + 0x40) * ACTOR_SIZE + ACTOR_QUAD_FLAGS, 0x40000000)
		engine.memory.write_u8(G_ACTOR_POOL + Math.s32(i + 0x40) * ACTOR_SIZE + ACTOR_DRAW_FLAGS, 0x84)
		engine.memory.write_u32(G_ACTOR_POOL + Math.s32(i + 0x40) * ACTOR_SIZE + ACTOR_FRAME_TABLE, G_SPRITE_FRAME_TABLE)
		engine.memory.write_u32(G_ACTOR_POOL + Math.s32(i + 0x40) * ACTOR_SIZE + ACTOR_SEQUENCE_TABLE,
				G_ACTOR_DEFAULT_SEQUENCE_TABLE)
		engine.memory.write_u32(G_ACTOR_POOL + Math.s32(i + 0x40) * ACTOR_SIZE + ACTOR_TPAGE_TABLE,
				G_ACTOR_DEFAULT_TEXTURE_BLOCKS)
		engine.memory.write_u16(G_ACTOR_POOL + Math.s32(i + 0x40) * ACTOR_SIZE + ACTOR_UNK_14,
				engine.memory.read_global("D_800C9A54"))
		engine.memory.write_u8(G_ACTOR_POOL + Math.s32(i + 0x40) * ACTOR_SIZE + ACTOR_UNK_04, 8)
		engine.memory.write_u8(G_ACTOR_POOL + Math.s32(i + 0x40) * ACTOR_SIZE + ACTOR_UNK_05, 1)
		engine.memory.write_u16(G_ACTOR_POOL + Math.s32(i + 0x40) * ACTOR_SIZE + ACTOR_UNK_18, 2)
		i = Math.s32(i + 1)
	engine.memory.write_u8(G_ACTOR_POOL + 94 * ACTOR_SIZE + ACTOR_UNK_01, 3)
	engine.memory.write_u8(G_ACTOR_POOL + 78 * ACTOR_SIZE + ACTOR_UNK_01, 4)
	engine.memory.write_u16(G_ACTOR_POOL + 94 * ACTOR_SIZE + ACTOR_SEQUENCE_SLOT, 0xF)
	engine.memory.write_u16(G_ACTOR_POOL + 94 * ACTOR_SIZE + ACTOR_X, 0)
	engine.memory.write_u16(G_ACTOR_POOL + 94 * ACTOR_SIZE + ACTOR_Y, 0)
	engine.memory.write_u16(G_ACTOR_POOL + 78 * ACTOR_SIZE + ACTOR_SEQUENCE_SLOT, 0xF)
	engine.memory.write_u16(G_ACTOR_POOL + 78 * ACTOR_SIZE + ACTOR_X, 0)
	engine.memory.write_u16(G_ACTOR_POOL + 78 * ACTOR_SIZE + ACTOR_Y, 0)
	match engine.memory.u8(g + GAME_STATE_ICON_MODE):
		0:
			i = 0
			while Math.u32(i) < engine.memory.u8(g + GAME_STATE_ICON_COUNT):
				engine.memory.write_u16(G_D_80125C10 + Math.s32(i * 2) * 2, engine.memory.s16(G_D_800B5AE4 + i * 4))
				engine.memory.write_u16(G_D_80125C10 + (Math.s32(Math.s32(i * 2) + 1)) * 2,
						engine.memory.s16(G_D_800B5AE4 + i * 4 + 0x2))
				i = Math.s32(i + 1)
		1:
			i = 0
			while Math.u32(i) < engine.memory.u8(g + GAME_STATE_ICON_COUNT):
				engine.memory.write_u16(G_D_80125C10 + Math.s32(i * 2) * 2, engine.memory.s16(G_D_800B5AA4 + i * 4))
				engine.memory.write_u16(G_D_80125C10 + (Math.s32(Math.s32(i * 2) + 1)) * 2,
						engine.memory.s16(G_D_800B5AA4 + i * 4 + 0x2))
				i = Math.s32(i + 1)
		2:
			zero_position_pair_count = 0
			j = 0
			while j < 0xF:
				if ((engine.memory.s16(G_D_80125C10 + Math.s32(j * 2) * 2)) == 0
						and (engine.memory.s16(G_D_80125C10 + (Math.s32(Math.s32(j * 2) + 1)) * 2)) == 0):
					zero_position_pair_count = Math.s32(zero_position_pair_count + 1)
				if zero_position_pair_count >= 2:
					zero_position_pair_count = 0
					while zero_position_pair_count < 0xF:
						engine.memory.write_u16(G_D_80125C10 + Math.s32(zero_position_pair_count * 2) * 2,
								engine.memory.s16(G_D_800B5AE4 + zero_position_pair_count * 4))
						engine.memory.write_u16(G_D_80125C10
								+ (Math.s32(Math.s32(zero_position_pair_count * 2) + 1)) * 2,
								engine.memory.s16(G_D_800B5AE4 + zero_position_pair_count * 4 + 0x2))
						zero_position_pair_count = Math.s32(zero_position_pair_count + 1)
					break
				j = Math.s32(j + 1)
	engine.call_c("hud_icon_layout_apply", [engine.memory.u8(g + GAME_STATE_ICON_COUNT)])
	engine.call_c("LoadSquare", [0x120, 0x1F1, 0x10, 1, G_D_800C6200])
	engine.call_c("LoadSquare", [0x120, 0x1F2, 0x10, 1, G_D_800C6220])
	engine.call_c("LoadSquare", [0x120, 0x1F3, 0x10, 1, G_D_800C6220 + 0x20])

## Calls menu_set.
func hud_icon_layout_apply(icon_count: int) -> void:
	icon_count = Math.s32(icon_count)
	var pad: int = 0
	var i: int = 0
	if icon_count != 0xF:
		icon_count = 0xE
		engine.gs_set("icon_count", 0xE)
	i = 0
	while i < icon_count:
		engine.memory.write_u16(engine.frame_base() + 0xC0 + i * 2, engine.memory.s16(G_D_80125C10 + i * 4) - 0xA)
		engine.memory.write_u16(engine.frame_base() + 0xA0 + i * 2, engine.memory.s16(G_D_80125C10 + i * 4 + 0x2) - 0xA)
		engine.memory.write_u16(engine.frame_base() + 0x80 + i * 2, 0x14)
		engine.memory.write_u16(engine.frame_base() + 0x60 + i * 2, 0x10)
		i = Math.s32(i + 1)
	i = 0
	engine.call_c("menu_set",
			[0, icon_count & 0xFF, engine.frame_base() + 0xC0, engine.frame_base() + 0xA0, engine.frame_base() + 0x80,
			engine.frame_base() + 0x60])
	i = 0
	while i < icon_count:
		engine.memory.write_u16(G_ACTOR_POOL + Math.s32(i + 0x50) * ACTOR_SIZE + ACTOR_SEQUENCE_SLOT, i)
		engine.memory.write_u16(G_ACTOR_POOL + Math.s32(i + 0x50) * ACTOR_SIZE + ACTOR_X,
				engine.memory.s16(G_D_80125C10 + i * 4))
		engine.memory.write_u16(G_ACTOR_POOL + Math.s32(i + 0x50) * ACTOR_SIZE + ACTOR_Y,
				engine.memory.s16(G_D_80125C10 + i * 4 + 0x2))
		i = Math.s32(i + 1)
	i = 0
	while i < icon_count:
		engine.memory.write_u16(G_ACTOR_POOL + Math.s32(i + 0x40) * ACTOR_SIZE + ACTOR_X,
				engine.memory.s16(G_D_80125C10 + i * 4))
		engine.memory.write_u16(G_ACTOR_POOL + Math.s32(i + 0x40) * ACTOR_SIZE + ACTOR_Y,
				engine.memory.s16(G_D_80125C10 + i * 4 + 0x2))
		engine.memory.write_u16(G_ACTOR_POOL + Math.s32(i + 0x40) * ACTOR_SIZE + ACTOR_UNK_18, 2)
		i = Math.s32(i + 1)
	if icon_count == 0xF:
		engine.memory.write_u16(G_ACTOR_POOL + 94 * ACTOR_SIZE + ACTOR_SEQUENCE_SLOT, 0xF)
		engine.memory.write_u16(G_ACTOR_POOL + 94 * ACTOR_SIZE + ACTOR_X, engine.memory.s16(G_D_80125C10 + 0x38))
		engine.memory.write_u16(G_ACTOR_POOL + 94 * ACTOR_SIZE + ACTOR_Y, engine.memory.s16(G_D_80125C10 + 0x3A))
		engine.memory.write_u16(G_ACTOR_POOL + 78 * ACTOR_SIZE + ACTOR_UNK_18, 2)
		engine.memory.write_u16(G_ACTOR_POOL + 78 * ACTOR_SIZE + ACTOR_X, engine.memory.s16(G_D_80125C10 + 0x38))
		engine.memory.write_u16(G_ACTOR_POOL + 78 * ACTOR_SIZE + ACTOR_Y, engine.memory.s16(G_D_80125C10 + 0x3A))
	else:
		engine.memory.write_u8(G_ACTOR_POOL + 78 * ACTOR_SIZE + ACTOR_DRAW_FLAGS, 0)
		engine.memory.write_u8(G_ACTOR_POOL + 94 * ACTOR_SIZE + ACTOR_DRAW_FLAGS, 0)

## Reads and writes memory only (no calls).
func hud_icon_memory_card_animation_set(arg0: int) -> void:
	arg0 = Math.u8(arg0)
	if arg0 != 0:
		engine.memory.write_u16(G_D_8012059A, 0xE)
		if engine.memory.s16(G_D_8012059A + 0x2) >= 4:
			engine.memory.write_u16(G_D_8012059A + 0x2, 0)
