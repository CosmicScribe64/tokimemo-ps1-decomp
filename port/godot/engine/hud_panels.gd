			engine.memory.write_u16(G_D_8012059A + 0x2, 0)

## Returns 0 when record idx of D_80125C10 moved by (dx, dy) leaves the screen (x0 < -160, x0 + 19 > 160, y0
## outside -120..120) or when one of its four corners lies in the 20 x 16 box of another of the 15 records, else
## 1. The corners are two local arrays filled from repeated expressions and tested in a 4-trip loop: IDO unrolls
## that loop, keeps the eight corner values in registers (one pair per test, so the outer loop runs out of
## caller-saved registers and spills the shared subexpressions to sp+0x20..0x28) and leaves the 15-trip loop
## rolled. T-25108.
func hud_icon_move_allowed(icon_index: int, delta_x: int, delta_y: int) -> int:
	icon_index = Math.s32(icon_index)
	delta_x = Math.s32(delta_x)
	delta_y = Math.s32(delta_y)
	var cx: Array[int] = []
	cx.resize(4)
	var cy: Array[int] = []
	cy.resize(4)
	var p: int = 0
	var i: int = 0
	var j: int = 0
	var move_allowed: int = 0
	var q: int = 0
	var tx: int = 0
	var ty: int = 0
	p = G_D_80125C10 + Math.s32(icon_index * 4)
	move_allowed = 1
	cx[0] = Math.s32(engine.memory.s16(p) + delta_x)
	cy[0] = Math.s32(engine.memory.s16(p + 0x2) + delta_y)
	cx[1] = Math.s32(Math.s32(engine.memory.s16(p) + delta_x) + 0x13)
	cy[1] = Math.s32(engine.memory.s16(p + 0x2) + delta_y)
	cx[2] = Math.s32(engine.memory.s16(p) + delta_x)
	cy[2] = Math.s32(Math.s32(engine.memory.s16(p + 0x2) + delta_y) + 0xF)
	cx[3] = Math.s32(Math.s32(engine.memory.s16(p) + delta_x) + 0x13)
	cy[3] = Math.s32(Math.s32(engine.memory.s16(p + 0x2) + delta_y) + 0xF)
	if cx[0] < -0xA0:
		return 0
	if cx[1] > 0xA0:
		return 0
	if cy[0] < -0x78:
		return 0
	if cy[1] > 0x78:
		return 0
	i = 0
	while i < 0xF:
		if i != icon_index:
			tx = engine.memory.s16(G_D_80125C10 + Math.s32(i * 4))
			ty = engine.memory.s16(G_D_80125C10 + Math.s32(i * 4) + 0x2)
			j = 0
			while j < 4:
				if ((cx[j] >= tx and cx[j] < Math.s32(tx + 0x14)) and cy[j] >= ty) and cy[j] < Math.s32(ty + 0x10):
					move_allowed = 0
				j = Math.s32(j + 1)
		i = Math.s32(i + 1)
	return move_allowed

## Cursor step of the 15-icon menu: every third frame of the pad repeat (`unk_F6C % 3 == 2`) moves the selected
## icon's position in D_80125C10 and the cursor record by the pad direction (`unk_F6F` pixels), unless
## hud_icon_move_allowed rejects the move, then clamps the icon to x -0x8A..0x80, y -0x5C..0x5C. Without pad
## input it runs the menu cursor check instead. A selection change restarts the 0x20-frame blink of D_800B5AA0,
## which scales the selected icons with rsin while `a` is 0; the loop sets the display modes of the icon records
## 64 + i and 80 + i, and the tail sets the page counter limits as hud_icon_memory_card_animation_set does. The
## selection index is read through `g`: the stores to D_80125C10 then reload the index expression (the original
## recomputes the address for the y store), and uopt keeps the index in $s3, re-read after each call.
func hud_icon_bar_update(a: int) -> void:
	a = Math.s32(a)
	var delta_x: int = 0
	var delta_y: int = 0
	var visible_icon_count: int = 0
	var previous_cursor_index: int = 0
	var i: int = 0
	var g: int = 0
	g = GS
	previous_cursor_index = Math.u8(engine.memory.s8(g + GAME_STATE_MENU_CURSOR_0))
	delta_x = 0
	delta_y = 0
	if (engine.memory.s32(g + GAME_STATE_PAD_HELD) & 1) != 0:
		if (_mod(engine.memory.u8(g + GAME_STATE_ICON_MODE), 3)) == 2:
			match engine.memory.s32(g + GAME_STATE_PAD_HELD) & 0xA000:
				0x8000:
					delta_x = Math.s32(-engine.memory.u8(g + GAME_STATE_CURSOR_SPEED))
				0x2000:
					delta_x = engine.memory.u8(g + GAME_STATE_CURSOR_SPEED)
			match Math.u32(engine.memory.s32(g + GAME_STATE_PAD_HELD)) & 0x5000:
				0x1000:
					delta_y = Math.s32(-engine.memory.u8(g + GAME_STATE_CURSOR_SPEED))
				0x4000:
					delta_y = engine.memory.u8(g + GAME_STATE_CURSOR_SPEED)
			if ((Math.s32(engine.call_c("hud_icon_move_allowed",
					[engine.memory.s8(g + GAME_STATE_MENU_CURSOR_0), delta_x, delta_y]))) == 0):
				delta_x = 0
				delta_y = 0
			engine.memory.write_u16(G_D_80125C10 + engine.memory.s8(g + GAME_STATE_MENU_CURSOR_0) * 4,
					Math.s32(engine.memory.s16(G_D_80125C10 + engine.memory.s8(g + GAME_STATE_MENU_CURSOR_0) * 4)
					+ delta_x))
			engine.memory.write_u16(G_D_80125C10 + engine.memory.s8(g + GAME_STATE_MENU_CURSOR_0) * 4 + 0x2,
					Math.s32(engine.memory.s16(G_D_80125C10 + engine.memory.s8(g + GAME_STATE_MENU_CURSOR_0) * 4 + 0x2)
					+ delta_y))
			engine.memory.write_u16(G_ACTOR_POOL + ACTOR_X, Math.s32(engine.memory.s16(G_ACTOR_POOL + ACTOR_X) + delta_x))
			engine.memory.write_u16(G_ACTOR_POOL + ACTOR_Y, Math.s32(engine.memory.s16(G_ACTOR_POOL + ACTOR_Y) + delta_y))
			engine.call_c("hud_icon_layout_apply", [engine.memory.u8(g + GAME_STATE_ICON_COUNT)])
			if (engine.memory.s16(G_D_80125C10 + engine.memory.s8(g + GAME_STATE_MENU_CURSOR_0) * 4)) > 0x80:
				engine.memory.write_u16(G_D_80125C10 + engine.memory.s8(g + GAME_STATE_MENU_CURSOR_0) * 4, 0x80)
			if (engine.memory.s16(G_D_80125C10 + engine.memory.s8(g + GAME_STATE_MENU_CURSOR_0) * 4)) < -0x8A:
				engine.memory.write_u16(G_D_80125C10 + engine.memory.s8(g + GAME_STATE_MENU_CURSOR_0) * 4, -0x8A)
			if (engine.memory.s16(G_D_80125C10 + engine.memory.s8(g + GAME_STATE_MENU_CURSOR_0) * 4 + 0x2)) < -0x5C:
				engine.memory.write_u16(G_D_80125C10 + engine.memory.s8(g + GAME_STATE_MENU_CURSOR_0) * 4 + 0x2, -0x5C)
			if (engine.memory.s16(G_D_80125C10 + engine.memory.s8(g + GAME_STATE_MENU_CURSOR_0) * 4 + 0x2)) > 0x5C:
				engine.memory.write_u16(G_D_80125C10 + engine.memory.s8(g + GAME_STATE_MENU_CURSOR_0) * 4 + 0x2, 0x5C)
	else:
		if Math.u32(a) < 0:
			engine.memory.write_u8(G_ACTOR_POOL + Math.s32(a + 0x40) * ACTOR_SIZE + ACTOR_UNK_01, 3)
		engine.call_c("menu_check", [0, engine.memory.s16(G_ACTOR_POOL + ACTOR_X), engine.memory.s16(G_ACTOR_POOL + ACTOR_Y)])
		engine.call_c("menu_cursor_update", [0])
	if previous_cursor_index != Math.u32(engine.memory.read_global("D_800B5A9C")):
		engine.memory.write_global("D_800B5A9C", engine.memory.s8(g + GAME_STATE_MENU_CURSOR_0))
		engine.memory.write_global("D_800B5AA0", 0x20)
	elif engine.memory.read_global("D_800B5AA0") != 0:
		engine.memory.write_global("D_800B5AA0", Math.u32(engine.memory.read_global("D_800B5AA0") - 1))
	visible_icon_count = 0xE
	if engine.memory.u8(g + GAME_STATE_ICON_COUNT) == 0xF:
		visible_icon_count = 0xF
	if engine.memory.u8(g + GAME_STATE_ICON_MODE) == 2:
		visible_icon_count = 0xF
	i = 0
	while i < visible_icon_count:
		if engine.halted():
			break
		if engine.memory.u8(G_ICON_ENABLED + i) == 0:
			engine.memory.write_u8(G_ACTOR_POOL + Math.s32(i + 0x50) * ACTOR_SIZE + ACTOR_FLAGS, 0)
			engine.memory.write_u8(G_ACTOR_POOL + Math.s32(i + 0x40) * ACTOR_SIZE + ACTOR_UNK_43, 0x51)
			engine.memory.write_u8(G_ACTOR_POOL + Math.s32(i + 0x40) * ACTOR_SIZE + ACTOR_UNK_01, 3)
		else:
			engine.memory.write_u8(G_ACTOR_POOL + Math.s32(i + 0x50) * ACTOR_SIZE + ACTOR_FLAGS, 1)
			engine.memory.write_u8(G_ACTOR_POOL + Math.s32(i + 0x40) * ACTOR_SIZE + ACTOR_UNK_01, 4)
			engine.memory.write_u8(G_ACTOR_POOL + Math.s32(i + 0x50) * ACTOR_SIZE + ACTOR_UNK_01, 3)
			if engine.memory.u8(g + GAME_STATE_MENU_ITEMS + i * 16 + MENU_ITEM_HOVER) != 0:
				engine.memory.write_u8(G_ACTOR_POOL + Math.s32(i + 0x40) * ACTOR_SIZE + ACTOR_UNK_43, 0x52)
				engine.memory.write_u8(G_ACTOR_POOL + Math.s32(i + 0x50) * ACTOR_SIZE + ACTOR_UNK_01, 2)
				engine.memory.write_u8(G_ACTOR_POOL + Math.s32(i + 0x40) * ACTOR_SIZE + ACTOR_UNK_01, 3)
				if a == 0:
					engine.memory.write_u16(G_ACTOR_POOL + Math.s32(i + 0x50) * ACTOR_SIZE + ACTOR_SCALE_X,
							Math.s32(Math.s32(engine.call_c("rsin",
							[Math.u32((Math.u32(0x20 - engine.memory.read_global("D_800B5AA0"))) << 6)])) + 0x1000))
					engine.memory.write_u16(G_ACTOR_POOL + Math.s32(i + 0x50) * ACTOR_SIZE + ACTOR_SCALE_Y,
							Math.s32(Math.s32(engine.call_c("rsin",
							[Math.u32((Math.u32(0x20 - engine.memory.read_global("D_800B5AA0"))) << 6)])) + 0x1000))
				else:
					engine.memory.write_u16(G_ACTOR_POOL + Math.s32(i + 0x50) * ACTOR_SIZE + ACTOR_SCALE_X, 0x1000)
					engine.memory.write_u16(G_ACTOR_POOL + Math.s32(i + 0x50) * ACTOR_SIZE + ACTOR_SCALE_Y, 0x1000)
			else:
				engine.memory.write_u8(G_ACTOR_POOL + Math.s32(i + 0x40) * ACTOR_SIZE + ACTOR_UNK_43, 0x53)
				if a == 0:
