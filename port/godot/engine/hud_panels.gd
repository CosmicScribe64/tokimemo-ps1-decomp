				engine.memory.write_u16(G_ACTOR_POOL + Math.s32(i + 3) * ACTOR_SIZE + ACTOR_X,
						Math.s32(Math.s32((Math.s32(engine.memory.read_global("D_800B5B24") - i)) * 0xE) - 0x87))
				engine.memory.write_u16(G_ACTOR_POOL + Math.s32(i + 3) * ACTOR_SIZE + ACTOR_Y, -0x51)
				i = Math.s32(i + 1)
			engine.memory.write_u16(G_ACTOR_POOL + 3 * ACTOR_SIZE + ACTOR_X,
					engine.memory.s16(G_ACTOR_POOL + 3 * ACTOR_SIZE + ACTOR_X) - 2)
			engine.memory.write_u16(G_ACTOR_POOL + (engine.memory.read_global("D_800B5B24") + 4) * ACTOR_SIZE + ACTOR_X,
					engine.memory.s16(G_ACTOR_POOL + (engine.memory.read_global("D_800B5B24") + 4) * ACTOR_SIZE
					+ ACTOR_X) + 2)
			x = -0x90
			y = -0x5A
			engine.call_c("prim_gradient_rect", [x, y, engine.memory.read_global("D_800B5B24") * 0xE + 8, 0x14, 2, 0x30E00, 0])
			engine.memory.write_u16(work, -0x8E)
			engine.memory.write_u16(work + TEXT_ENTRY_Y, -0x58)
			return
		i = 0
		while i < (engine.memory.read_global("D_800B5B24") + 2):
			engine.memory.write_u16(G_ACTOR_POOL + Math.s32(i + 3) * ACTOR_SIZE + ACTOR_X,
					Math.s32(Math.s32((Math.s32(engine.memory.read_global("D_800B5B24") - i)) * 0xE) - 0xC7))
			engine.memory.write_u16(G_ACTOR_POOL + Math.s32(i + 3) * ACTOR_SIZE + ACTOR_Y, -0x91)
			i = Math.s32(i + 1)
		engine.memory.write_u16(G_ACTOR_POOL + 3 * ACTOR_SIZE + ACTOR_X,
				engine.memory.s16(G_ACTOR_POOL + 3 * ACTOR_SIZE + ACTOR_X) - 2)
		engine.memory.write_u16(G_ACTOR_POOL + (engine.memory.read_global("D_800B5B24") + 4) * ACTOR_SIZE + ACTOR_X,
				engine.memory.s16(G_ACTOR_POOL + (engine.memory.read_global("D_800B5B24") + 4) * ACTOR_SIZE + ACTOR_X)
				+ 2)
		x = -0xD0
		y = -0x9A
		engine.call_c("prim_gradient_rect", [x, y, engine.memory.read_global("D_800B5B24") * 0xE + 8, 0x14, 2, 0x30E00, 0])
		engine.memory.write_u16(work, -0xCE)
		engine.memory.write_u16(work + TEXT_ENTRY_Y, -0x98)

## Reads and writes memory only (no calls).
func hud_season_index() -> int:
	match engine.gs_get("month"):
		6, 7, 8:
			return 1
		9, 0xA, 0xB:
			return 2
		1, 2, 0xC:
			return 3
		_:
			return 0

## Reads and writes memory only (no calls).
func hud_in_summer_months() -> int:
	match engine.gs_get("month"):
		6, 7, 8, 9:
			return 1
		_:
			return 0

## Calls hud_in_summer_months.
func hud_summer_phase() -> int:
	var summer_phase: int = 0
	summer_phase = Math.s32(engine.call_c("hud_in_summer_months"))
	if engine.gs_get("month") == 9:
		if engine.gs_get("day") >= 0x18:
			summer_phase = -0x1
	if engine.gs_get("month") == 5:
		if engine.gs_get("day") >= 0x19:
			summer_phase = -0x1
	return summer_phase

## Reads and writes memory only (no calls).
func hud_vacation_for_date(month: int, day_of_month: int) -> int:
	month = Math.s32(month)
	day_of_month = Math.s32(day_of_month)
	if month == 8:
		return 1
	if month == 7 and day_of_month >= 0x18:
		return 1
	if month == 0xC and day_of_month >= 0x19:
		return 2
	if month == 0xD and day_of_month < 8:
		return 2
	if month == 1 and day_of_month < 8:
		return 2
	if month == 3 and day_of_month >= 0x18:
		return 3
	if month == 4 and day_of_month < 4:
		return 3
	return 0

## Calls AddPrim, GetWorkBase, LoadSquare, SetSemiTrans, func_8009ED74, func_8009F0A4, func_800A0140, goto_tpage,
## hud_season_index, rand, rsin.
func hud_screen_frame_draw(a: int) -> void:
	a = Math.s32(a)
	var x: int = 0
	var y: int = 0
	var old_index: int = 0
	var next_index: int = 0
	var blend: int = 0
	var fade: int = 0
	var row: int = 0
	var col: int = 0
	var spr: int = 0
	var current: int = 0
	var old: int = 0
	var next: int = 0
	var out: int = 0
	var old_weight: int = 0
	var next_weight: int = 0
	var enabled: Array[int] = []
	enabled.resize(80)
	current = Math.s32(engine.call_c("hud_season_index"))
	match engine.memory.u8(GS + GAME_STATE_PLAYER_FLAGS + 0x1) & 0xF:
		1:
			if (engine.gs_get("frame_count") & 3) == 3:
				engine.memory.write_global("D_800B5BD0", Math.u32(engine.memory.read_global("D_800B5BD0") - 1))
			if (engine.gs_get("frame_count") & 1) == 1:
				engine.memory.write_global("D_800B5BCC", engine.memory.read_global("D_800B5BCC") + 1)
		2:
			if (engine.gs_get("frame_count") & 7) == 7:
				engine.memory.write_global("D_800B5BD0", Math.u32(engine.memory.read_global("D_800B5BD0") - 1))
			if (engine.gs_get("frame_count") & 3) == 3:
				engine.memory.write_global("D_800B5BCC", engine.memory.read_global("D_800B5BCC") + 1)
		3:
			if (engine.gs_get("frame_count") & 0x15) == 0x15:
				engine.memory.write_global("D_800B5BD0", Math.u32(engine.memory.read_global("D_800B5BD0") - 1))
			if (engine.gs_get("frame_count") & 7) == 7:
				engine.memory.write_global("D_800B5BCC", engine.memory.read_global("D_800B5BCC") + 1)
		4:
			engine.memory.write_global("D_800B5BD0",
					Math.u32(engine.memory.read_global("D_800B5BD0") + 0x10 - (Math.s32(engine.call_c("rand")) & 0x1F)))
			engine.memory.write_global("D_800B5BCC",
					Math.u32(engine.memory.read_global("D_800B5BCC") + 0x10 - (Math.s32(engine.call_c("rand")) & 0x1F)))
		5:
			engine.memory.write_global("D_800B5BD0",
					Math.u32(engine.memory.read_global("D_800B5BD0")
					+ _div(Math.s32(engine.call_c("rsin", [engine.gs_get("frame_count")])), 0x20)))
			engine.memory.write_global("D_800B5BCC",
					Math.u32(engine.memory.read_global("D_800B5BCC")
					+ _div(Math.s32(engine.call_c("func_800A0140", [Math.s32(engine.gs_get("frame_count"))])), 0x20)))
		_:
			if (engine.gs_get("frame_count") & 1) == 1:
				engine.memory.write_global("D_800B5BD0", Math.u32(engine.memory.read_global("D_800B5BD0") - 1))
			engine.memory.write_global("D_800B5BCC", engine.memory.read_global("D_800B5BCC") + 1)
	row = 0
	while row < 8:
		col = 0
		while col < 0xA:
			enabled[col * 8 + row] = 1
			col = Math.s32(col + 1)
		row = Math.s32(row + 1)
	match a:
		0:
			pass
		1:
			row = 1
			while row < 6:
				col = 1
				while col < 9:
					enabled[col * 8 + row] = 0
					col = Math.s32(col + 1)
				row = Math.s32(row + 1)
		2:
			row = 0
			while row < 6:
				col = 0
				while col < 0xA:
					enabled[col * 8 + row] = 0
					col = Math.s32(col + 1)
				row = Math.s32(row + 1)
			enabled[0 * 8 + 6] = 1
			enabled[9 * 8 + 6] = 1
			enabled[0 * 8 + 5] = 1
			enabled[9 * 8 + 5] = 1
	row = 0
	while row < 8:
		if engine.halted():
			break
		col = 0
		while col < 0xA:
			if engine.halted():
				break
			if enabled[col * 8 + row] != 0:
				spr = Math.u32(engine.call_c("GetWorkBase", [0x14, engine.memory.read_global("draw_buffer")]))
				engine.call_c("func_8009F0A4", [spr])
				engine.call_c("SetSemiTrans", [spr, 0])
				x = Math.s32(col * 0x20)
				y = Math.s32(Math.u32(Math.u32(row) * 0x20) + 0xF0)
				engine.memory.write_u16(spr + SPRT_X0, x)
				engine.memory.write_u16(spr + SPRT_Y0, Math.s32(y - Math.s32(engine.memory.read_global("draw_buffer") * 0xF0)))
				engine.memory.write_u8(spr + SPRT_U0, (engine.memory.read_global("D_800B5BCC") & 0x1F) + 0x80)
				engine.memory.write_u8(spr + SPRT_V0, (engine.memory.read_global("D_800B5BD0") & 0x1F) + 0x80)
				engine.memory.write_u16(spr + SPRT_H, 0x20)
				engine.memory.write_u16(spr + SPRT_W, 0x20)
				engine.memory.write_u8(spr + SPRT_R0, engine.gs_get("screen_brightness"))
				engine.memory.write_u8(spr + SPRT_G0, engine.gs_get("screen_brightness"))
				engine.memory.write_u8(spr + SPRT_B0, engine.gs_get("screen_brightness"))
				engine.memory.write_u16(spr + SPRT_CLUT, Math.s32(engine.call_c("func_8009ED74", [0xA0, 0x1E1])))
				engine.call_c("AddPrim",
						[Math.u32(Math.u32(G_DRAW_OT_TAGS + (engine.memory.read_global("draw_buffer") << 10))
						+ Math.u8(engine.memory.read_global("D_800B5BD4")) * 4), Math.s32(spr)])
			col = Math.s32(col + 1)
		row = Math.s32(row + 1)
	engine.call_c("goto_tpage", [0x3C0, 0x100, Math.u8(engine.memory.read_global("D_800B5BD4")), 0, 0])
	if (engine.gs_get("frame_count") & 3) == 3 and engine.memory.read_global("D_800B5BC8") >= 0xEF:
		engine.memory.write_global("D_800B5BC8", engine.memory.read_global("D_800B5BC8") + 1)
		fade = engine.memory.read_global("D_800B5BC8")
		if fade == 0xFF:
			current = Math.s32(current + 1)
			engine.call_c("LoadSquare", [0xA0, 0x1E1, 0x10, 1, G_D_800B5B28 + (Math.s32(current + 3) & 3) * 32])
			return
		if fade >= 0xF0:
			next_weight = Math.s32(fade - 0xEF)
			old_weight = 0xFF - fade
			old_index = Math.s32(current + 3) & 3
			next_index = Math.s32(current + 4) & 3
			old = G_D_800B5B28 + old_index * 32
			next = G_D_800B5B28 + next_index * 32
			out = G_D_800B5BA8
			col = 0
			while col < 8:
				blend = Math.u32(Math.u32(old_weight * (engine.memory.u32(old) & 0x1F))
						+ Math.u32(next_weight * (engine.memory.u32(next) & 0x1F)))
				engine.memory.write_u32(out, (engine.memory.u32(out) & 0xFFFFFFE0) | (blend >> 4 & 0x1F))
				blend = Math.u32(Math.u32(old_weight * ((engine.memory.u32(old) >> 5) & 0x1F))
						+ Math.u32(next_weight * ((engine.memory.u32(next) >> 5) & 0x1F)))
				engine.memory.write_u32(out, (engine.memory.u32(out) & 0xFFFFFC1F) | ((blend >> 4 & 0x1F) << 5))
				blend = Math.u32(Math.u32(old_weight * ((engine.memory.u32(old) >> 10) & 0x1F))
						+ Math.u32(next_weight * ((engine.memory.u32(next) >> 10) & 0x1F)))
				engine.memory.write_u32(out, (engine.memory.u32(out) & 0xFFFF83FF) | ((blend >> 4 & 0x1F) << 10))
				blend = Math.u32(Math.u32(old_weight * ((engine.memory.u32(old) >> 16) & 0x1F))
						+ Math.u32(next_weight * ((engine.memory.u32(next) >> 16) & 0x1F)))
				engine.memory.write_u32(out, (engine.memory.u32(out) & 0xFFE0FFFF) | ((blend >> 4 & 0x1F) << 16))
				blend = Math.u32(Math.u32(old_weight * ((engine.memory.u32(old) >> 21) & 0x1F))
						+ Math.u32(next_weight * ((engine.memory.u32(next) >> 21) & 0x1F)))
				engine.memory.write_u32(out, (engine.memory.u32(out) & 0xFC1FFFFF) | ((blend >> 4 & 0x1F) << 21))
				blend = Math.u32(Math.u32(old_weight * ((engine.memory.u32(old) >> 26) & 0x1F))
						+ Math.u32(next_weight * ((engine.memory.u32(next) >> 26) & 0x1F)))
				engine.memory.write_u32(out, (engine.memory.u32(out) & 0x83FFFFFF) | ((blend >> 4 & 0x1F) << 26))
				old = old + 0x4
				next = next + 0x4
				out = out + 0x4
				col = Math.s32(col + 1)
			engine.call_c("LoadSquare", [0xA0, 0x1E1, 0x10, 1, G_D_800B5BA8])

## Calls LoadSquare.
func hud_vram_init() -> void:
	var i: int = 0
	var j: int = 0
	engine.call_c("LoadSquare", [0x3E0, 0x180, 0x20, 0x80, engine.memory.read_global("D_800B374C")])
	i = 0
	while i < 0x20:
		j = 0
		while j < 4:
			engine.memory.write_u32(GS + GAME_STATE_SCRATCH_WORDS + (Math.s32(Math.s32(i * 4) + j)) * 4, 0)
			j = Math.s32(j + 1)
		i = Math.s32(i + 1)
	engine.call_c("LoadSquare", [0x3E0, 0x1C0, 4, 0x10, GS + GAME_STATE_SCRATCH_WORDS])

## Calls audio_bank_load_start, audio_command, hud_season_index.
func hud_season_bgm_load() -> void:
	var v: int = 0
	engine.call_c("audio_command", [5])
	engine.call_c("audio_command", [0x71])
	v = Math.s32(engine.call_c("hud_season_index")) & 3
	engine.call_c("audio_bank_load_start",
			[0, 0xBF98, 0xBF79, engine.memory.s32(G_D_800B5BE8 + v * 4), engine.memory.s32(G_D_800B5BF8 + v * 4),
			engine.memory.s32(G_D_800B5BD8 + v * 4)])

