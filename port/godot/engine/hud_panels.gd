## Reads and writes memory only (no calls).
func portrait_value_clear_if_high(arg0: int) -> void:
	arg0 = Math.s32(arg0)
	if engine.memory.read_global("D_800B5A64") >= 0xA5:
		engine.memory.write_global("D_800B5A64", 0)

## Reads and writes memory only (no calls).
func portrait_expression_select(expression_variant: int) -> void:
	expression_variant = Math.u32(expression_variant)
	match expression_variant:
		0:
			engine.memory.write_u16(G_SPRITE_QUADS + SPRITE_QUAD_SIZE + SPRITE_QUAD_UNK_0C, 7)
			engine.memory.write_u16(G_SPRITE_QUADS + SPRITE_QUAD_UNK_0C, 7)
			return
		1:
			engine.memory.write_u16(G_SPRITE_QUADS + SPRITE_QUAD_SIZE + SPRITE_QUAD_UNK_0C, 7)
			engine.memory.write_u8(G_SPRITE_QUADS + SPRITE_QUAD_SIZE + SPRITE_QUAD_UNK_0E,
					engine.memory.u8(G_SPRITE_QUADS + SPRITE_QUAD_SIZE + SPRITE_QUAD_UNK_0E) + 0x40)
			engine.memory.write_u16(G_SPRITE_QUADS + SPRITE_QUAD_UNK_0C, 7)
			engine.memory.write_u8(G_SPRITE_QUADS + SPRITE_QUAD_UNK_0E,
					engine.memory.u8(G_SPRITE_QUADS + SPRITE_QUAD_UNK_0E) + 0x40)
			return
		2:
			engine.memory.write_u16(G_SPRITE_QUADS + SPRITE_QUAD_SIZE + SPRITE_QUAD_UNK_0C, 8)
			engine.memory.write_u16(G_SPRITE_QUADS + SPRITE_QUAD_UNK_0C, 8)
			return
		3:
			engine.memory.write_u16(G_SPRITE_QUADS + SPRITE_QUAD_SIZE + SPRITE_QUAD_UNK_0C, 8)
			engine.memory.write_u8(G_SPRITE_QUADS + SPRITE_QUAD_SIZE + SPRITE_QUAD_UNK_0E,
					engine.memory.u8(G_SPRITE_QUADS + SPRITE_QUAD_SIZE + SPRITE_QUAD_UNK_0E) + 0x40)
			engine.memory.write_u16(G_SPRITE_QUADS + SPRITE_QUAD_UNK_0C, 8)
			engine.memory.write_u8(G_SPRITE_QUADS + SPRITE_QUAD_UNK_0E,
					engine.memory.u8(G_SPRITE_QUADS + SPRITE_QUAD_UNK_0E) + 0x40)
			return
		4:
			engine.memory.write_u16(G_SPRITE_QUADS + SPRITE_QUAD_SIZE + SPRITE_QUAD_UNK_0C, 9)
			engine.memory.write_u16(G_SPRITE_QUADS + SPRITE_QUAD_UNK_0C, 9)
			return
		5:
			engine.memory.write_u16(G_SPRITE_QUADS + SPRITE_QUAD_SIZE + SPRITE_QUAD_UNK_0C, 9)
			engine.memory.write_u8(G_SPRITE_QUADS + SPRITE_QUAD_SIZE + SPRITE_QUAD_UNK_0E,
					engine.memory.u8(G_SPRITE_QUADS + SPRITE_QUAD_SIZE + SPRITE_QUAD_UNK_0E) + 0x40)
			engine.memory.write_u16(G_SPRITE_QUADS + SPRITE_QUAD_UNK_0C, 9)
			engine.memory.write_u8(G_SPRITE_QUADS + SPRITE_QUAD_UNK_0E,
					engine.memory.u8(G_SPRITE_QUADS + SPRITE_QUAD_UNK_0E) + 0x40)
			return

## Calls cd_audio_state, getCDlevel.
func portrait_face_update() -> void:
	var max_: int = 0
	var level: int = 0
	var n: int = 0
	var saved: int = 0
	var i: int = 0
	var girl_id: int = 0
	var face: int = 0
	engine.memory.write_u8(G_ACTOR_POOL + 31 * ACTOR_SIZE + ACTOR_BRIGHTNESS, 0x80)
	engine.memory.write_u32(G_ACTOR_POOL + 31 * ACTOR_SIZE + ACTOR_QUAD_FLAGS,
			engine.memory.s32(G_ACTOR_POOL + 31 * ACTOR_SIZE + ACTOR_QUAD_FLAGS) & 0x7FFFFFFF)
	engine.memory.write_u32(G_SPRITE_QUADS, engine.memory.s32(G_SPRITE_QUADS) & 0x7FFFFFFF)
	engine.memory.write_u32(G_SPRITE_QUADS + SPRITE_QUAD_SIZE,
			engine.memory.s32(G_SPRITE_QUADS + SPRITE_QUAD_SIZE) & 0x7FFFFFFF)
	saved = engine.memory.s16(G_ACTOR_POOL + 30 * ACTOR_SIZE + ACTOR_UNK_18)
	if engine.memory.u8(GS + 0x3C) != 0:
		if (Math.u8(engine.call_c("cd_audio_state")) & 4) != 0:
			level = Math.s16(engine.call_c("getCDlevel")) + 1
		else:
			level = 0
		engine.memory.write_u16(G_D_80125C80 + (engine.gs_get("frame_count") & 3) * 2, level)
		max_ = 0
		i = 0
		while i < 4:
			if max_ < engine.memory.s16(G_D_80125C80 + i * 2):
				max_ = engine.memory.s16(G_D_80125C80 + i * 2)
			i = Math.s32(i + 1)
		n = 0
		girl_id = engine.gs_get("current_girl")
		i = 0
		while i < 3:
			if engine.memory.u8(G_D_800B5A68 + girl_id * 3 + i) < Math.u32(level):
				n = Math.s32(i + 1)
			i = Math.s32(i + 1)
		if n >= 4:
			n = 3
		if engine.memory.u8(G_SPRITE_QUADS + SPRITE_QUAD_UNK_0F) == 0 or not ((engine.gs_get("frame_count") & 1) != 0):
			if level == 0:
				engine.memory.write_u8(G_SPRITE_QUADS + SPRITE_QUAD_UNK_0F, 0)
			elif n == 0:
				engine.memory.write_u8(G_SPRITE_QUADS + SPRITE_QUAD_UNK_0F, 0)
			elif n == 1:
				engine.memory.write_u8(G_SPRITE_QUADS + SPRITE_QUAD_UNK_0F, 0x10)
			elif n == 2:
				engine.memory.write_u8(G_SPRITE_QUADS + SPRITE_QUAD_UNK_0F, 0x20)
			elif n >= 3:
				engine.memory.write_u8(G_SPRITE_QUADS + SPRITE_QUAD_UNK_0F, 0x30)
		if (engine.gs_get("pad_held") & 0x80) != 0:
			engine.memory.write_global("D_800B5A98", 0)
		if engine.memory.read_global("D_800B5A98") < level:
			engine.memory.write_global("D_800B5A98", level)
	else:
		face = engine.memory.s16(G_ACTOR_POOL + 31 * ACTOR_SIZE + ACTOR_UNK_18)
		engine.memory.write_u8(G_SPRITE_QUADS + SPRITE_QUAD_UNK_0F, Math.s32(face * 0x10))
	engine.memory.write_u8(G_SPRITE_QUADS + SPRITE_QUAD_SIZE + SPRITE_QUAD_UNK_0F, Math.s32(saved << 5))

## Sets the speech portrait state when voice playback is inactive.
func bustup_speech() -> void:
	if engine.memory.u8(GS + 0x3C) == 0 and not ((engine.memory.read_global("D_8011F50E") & 1) != 0):
		engine.memory.write_global("D_8011F50E", (engine.memory.read_global("D_8011F50E") & 0xFF) | 0x11)

## Sets the portrait wink state when no wink is already active.
func bustup_wink() -> void:
	if not ((engine.memory.read_global("D_8011F4CA") & 1) != 0):
		engine.memory.write_global("D_8011F4CA", (engine.memory.read_global("D_8011F4CA") & 0xFF) | 0x11)

## nine +0xFC records, reached by byte offset: the word view (value) and the s16 at +2 (cap)
func parameter_change(parameter_id: int, delta: int) -> void:
	parameter_id = Math.s32(parameter_id)
	delta = Math.s32(delta)
	var p: int = 0
	p = Math.u32(GS + parameter_id * 4)
	engine.memory.write_u32(p + 0xFC, Math.s32(engine.memory.s32(p + 0xFC) + delta))
	if engine.memory.s32(p + 0xFC) < 0:
		engine.memory.write_u32(p + 0xFC, 0)
	if engine.memory.s16(p + 0xFE) >= 0x3E8:
		engine.memory.write_u16(p + 0xFE, 0x3E7)

## Shows or hides the parameter-panel actor group.
func parameter_disp_switch(arg0: int) -> void:
	arg0 = Math.s32(arg0)
	var i: int = 0
	if arg0 == 1:
		i = 0
		while i < 0x1C:
			engine.memory.write_u8(G_ACTOR_POOL + Math.s32(i + 0x20) * ACTOR_SIZE + ACTOR_DRAW_FLAGS,
					(engine.memory.u8(G_ACTOR_POOL + Math.s32(i + 0x20) * ACTOR_SIZE + ACTOR_DRAW_FLAGS)) | 0x80)
			i = Math.s32(i + 1)
	else:
		i = 0
		while i < 0x1C:
			engine.memory.write_u8(G_ACTOR_POOL + Math.s32(i + 0x20) * ACTOR_SIZE + ACTOR_DRAW_FLAGS,
					(engine.memory.u8(G_ACTOR_POOL + Math.s32(i + 0x20) * ACTOR_SIZE + ACTOR_DRAW_FLAGS)) & 0x7F)
			i = Math.s32(i + 1)

