					engine.memory.write_u16(G_ACTOR_POOL + Math.s32(i + 0x50) * ACTOR_SIZE + ACTOR_SCALE_Y, 0x1000)
					engine.memory.write_u16(G_ACTOR_POOL + Math.s32(i + 0x40) * ACTOR_SIZE + ACTOR_SCALE_X, 0x1000)
					engine.memory.write_u16(G_ACTOR_POOL + Math.s32(i + 0x40) * ACTOR_SIZE + ACTOR_SCALE_Y, 0x1000)
				else:
