## Draws the parameter panel and updates its parameter indicators.
func parameter_show() -> void:
	var i: int = 0
	var d: int = 0
	var step: int = 0
	var tab: int = 0
	if engine.gs_get("sd_anim_fast") != 0:
		step = 4
	else:
		step = 8
	tab = G_ACTOR_POOL
	if (engine.memory.u8(tab + 32 * ACTOR_SIZE + ACTOR_DRAW_FLAGS) & 0x80) != 0:
		engine.call_c("prim_gradient_rect", [-0x84, -0x61, 0x108, 0x2A, 0xC, 0x30E00, 0])
		engine.call_c("dtd_on", [0xC])
		i = 0x20
		while i < 0x38:
			if engine.memory.s16(tab + i * ACTOR_SIZE + ACTOR_DX) == 1:
				d = _div(0x1000, step)
				engine.memory.write_u16(tab + i * ACTOR_SIZE + ACTOR_UNK_08,
						Math.s32(engine.memory.s16(tab + i * ACTOR_SIZE + ACTOR_UNK_08) + d))
				engine.memory.write_u16(tab + i * ACTOR_SIZE + ACTOR_SCALE_X,
						Math.s32(engine.memory.s16(tab + i * ACTOR_SIZE + ACTOR_SCALE_X) - d))
				if d >= engine.memory.s16(tab + i * ACTOR_SIZE + ACTOR_SCALE_X):
					engine.memory.write_u16(tab + i * ACTOR_SIZE + ACTOR_DX, 2)
			elif engine.memory.s16(tab + i * ACTOR_SIZE + ACTOR_DX) == 2:
				d = _div(0x1000, step)
				engine.memory.write_u16(tab + i * ACTOR_SIZE + ACTOR_UNK_08,
						Math.s32(engine.memory.s16(tab + i * ACTOR_SIZE + ACTOR_UNK_08) - d))
				engine.memory.write_u16(tab + i * ACTOR_SIZE + ACTOR_SCALE_X,
						Math.s32(engine.memory.s16(tab + i * ACTOR_SIZE + ACTOR_SCALE_X) + d))
				if engine.memory.s16(tab + i * ACTOR_SIZE + ACTOR_SCALE_X) >= 0x1000:
					engine.memory.write_u16(tab + i * ACTOR_SIZE + ACTOR_SCALE_X, 0x1000)
					engine.memory.write_u16(tab + i * ACTOR_SIZE + ACTOR_DX, 0)
					engine.memory.write_u16(tab + i * ACTOR_SIZE + ACTOR_UNK_08, 0)
			i = Math.s32(i + 1)
		i = 0x38
		while i < 0x3B:
			if engine.memory.s16(tab + i * ACTOR_SIZE + ACTOR_DX) == 1:
				d = _div(0x1000, step)
				engine.memory.write_u16(tab + i * ACTOR_SIZE + ACTOR_SCALE_Y,
						Math.s32(engine.memory.s16(tab + i * ACTOR_SIZE + ACTOR_SCALE_Y) - d))
				if d >= engine.memory.s16(tab + i * ACTOR_SIZE + ACTOR_SCALE_Y):
					engine.memory.write_u16(tab + i * ACTOR_SIZE + ACTOR_DX, 2)
			elif engine.memory.s16(tab + i * ACTOR_SIZE + ACTOR_DX) == 2:
				engine.memory.write_u16(tab + i * ACTOR_SIZE + ACTOR_SCALE_Y,
						engine.memory.s16(tab + i * ACTOR_SIZE + ACTOR_SCALE_Y) + _div(0x1000, step))
				if engine.memory.s16(tab + i * ACTOR_SIZE + ACTOR_SCALE_Y) >= 0x1000:
					engine.memory.write_u16(tab + i * ACTOR_SIZE + ACTOR_SCALE_Y, 0x1000)
					engine.memory.write_u16(tab + i * ACTOR_SIZE + ACTOR_DX, 0)
			i = Math.s32(i + 1)

## Show or hide the calendar date HUD
func hizuke_disp_switch(arg0: int) -> void:
	arg0 = Math.s32(arg0)
	var i: int = 0
	if arg0 == 1:
		i = 0
		while i < 8:
			engine.memory.write_u8(G_ACTOR_POOL + Math.s32(i + 0x10) * ACTOR_SIZE + ACTOR_DRAW_FLAGS,
					(engine.memory.u8(G_ACTOR_POOL + Math.s32(i + 0x10) * ACTOR_SIZE + ACTOR_DRAW_FLAGS)) | 0x80)
			i = Math.s32(i + 1)
	else:
		i = 0
		while i < 8:
			engine.memory.write_u8(G_ACTOR_POOL + Math.s32(i + 0x10) * ACTOR_SIZE + ACTOR_DRAW_FLAGS,
					(engine.memory.u8(G_ACTOR_POOL + Math.s32(i + 0x10) * ACTOR_SIZE + ACTOR_DRAW_FLAGS)) & 0x7F)
			i = Math.s32(i + 1)

## Create the calendar date actors (month, day, weekday) for the HUD
func hizuke_init() -> void:
	var i: int = 0
	var digit: int = 0
	var day_kind: int = 0
	i = engine.gs_get("month")
	i = engine.gs_get("day")
	i = 0
	while i != 8:
		if engine.halted():
			break
		engine.call_c("actor_clear", [Math.s32(i + 0x10)])
		engine.memory.write_u8(G_ACTOR_POOL + Math.s32(i + 0x10) * ACTOR_SIZE + ACTOR_UNK_01, 4)
		engine.memory.write_u8(G_ACTOR_POOL + Math.s32(i + 0x10) * ACTOR_SIZE + ACTOR_FLAGS, 0x40)
		engine.memory.write_u32(G_ACTOR_POOL + Math.s32(i + 0x10) * ACTOR_SIZE + ACTOR_QUAD_FLAGS, 0x40000000)
		engine.memory.write_u8(G_ACTOR_POOL + Math.s32(i + 0x10) * ACTOR_SIZE + ACTOR_DRAW_FLAGS, 0x84)
